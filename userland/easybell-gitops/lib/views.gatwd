-- Views over a gitops_graph: one tree per Ingress (Ingress -> Service -> Deployment) whose
-- labels carry the hosts, the IP and the port names. Pure DSL; the graph is the only input.

-- A field of a resource, or "-" when the path is absent (nothing is silently dropped).
def gp_or = \d xs -> head (xs ++ [d])
def gp_field = \path r -> gp_or "-" [ (hamt_path path q) | q <- [r], hamt_has_path path q ]

-- Annotation lookup by its FULL key (keys contain dots, so hamt_path cannot address them).
def gp_annotation = \key r -> gp_or "-" [ (hamt_get_or "-" key (hamt_path "metadata.annotations" q))
    | q <- [r], hamt_has_path "metadata.annotations" q ]

-- The address external-dns publishes for an Ingress.
def gp_ip = \r -> gp_annotation "external-dns.alpha.kubernetes.io/target" r

-- Every rule's host, for the rules of a resource that declare one.
def gp_rule_hosts = \i -> [ (hamt_path "host" rule)
    | q <- [i]
    , hamt_has_path "spec.rules" q
    , rule <- (hamt_path "spec.rules" q)
    , hamt_has_path "host" rule ]

-- A list of strings, comma-joined, or "-" when it is empty (never a silent blank label).
def gp_join_or = \xs -> gp_or "-" [ (str_join "," q) | q <- [xs], (length q) > 0 ]

-- Hosts an Ingress answers for, comma-joined (falling back to "-" when it has none).
def gp_hosts = \i -> gp_join_or (gp_rule_hosts i)

-- "name:port" entries of a Service's ports.
def gp_port_entry = \p -> (gp_field "name" p) ++ ":" ++ (str_from (gp_field "port" p))

def gp_service_ports = \s -> str_join "," [ (gp_port_entry p)
    | q <- [s], hamt_has_path "spec.ports" q, p <- (hamt_path "spec.ports" q) ]

-- "name:containerPort" entries over all containers of a Deployment.
def gp_container_port_entry = \p -> (gp_field "name" p) ++ ":" ++ (str_from (gp_field "containerPort" p))

def gp_container_ports = \d -> str_join "," [ (gp_container_port_entry p)
    | q <- [d]
    , hamt_has_path "spec.template.spec.containers" q
    , c <- (hamt_path "spec.template.spec.containers" q)
    , hamt_has_path "ports" c
    , p <- (hamt_path "ports" c) ]

-- The backend's port.number, as text (the fallback when a path names no port.name).
def gp_backend_port_number = \path -> str_from (gp_field "backend.service.port.number" path)

-- The backend's port.name, when a path names one.
def gp_backend_port_names = \path -> [ (hamt_path "backend.service.port.name" b)
    | b <- [path], hamt_has_path "backend.service.port.name" b ]

-- A rule path's backend port: its name if it has one, else its number as text.
def gp_backend_port_of = \path -> gp_or (gp_backend_port_number path) (gp_backend_port_names path)

-- Backend port (name or number) an Ingress uses for a Service name.
def gp_backend_port = \svc i -> str_join "," [ (gp_backend_port_of path)
    | rule <- (hamt_path "spec.rules" i)
    , hamt_has_path "http.paths" rule
    , path <- (hamt_path "http.paths" rule)
    , hamt_has_path "backend.service.name" path
    , (hamt_path "backend.service.name" path) == svc ]

def gp_payload = \id g -> head [ p | p <- (graph_payloads g), (k8s_id_of p) == id ]

-- "key=value", used to assemble the space-separated label fields below.
def gp_kv = \k v -> k ++ "=" ++ v

-- A tree label: a name followed by its "key=value" fields, space-joined.
def gp_label = \name kvs -> str_join " " ([name] ++ kvs)

-- A Service's workload child is whatever kind of pod-template-bearing resource gp_exposes_specs
-- matched it to (Deployment or StatefulSet); label it by its real kind, never assume one.
def gp_workload_label = \p id -> gp_label ((hamt_get "kind" p) ++ " " ++ (k8s_short id)) [ (gp_kv "containerPorts" (gp_container_ports p)) ]

def gp_workload_tree = \id g -> tree_leaf (gp_workload_label (gp_payload id g) id)

def gp_service_label = \p i id -> gp_label ("Service " ++ (k8s_short id)) [ (gp_kv "via" (gp_backend_port (hamt_path "metadata.name" p) i))
    , (gp_kv "ports" (gp_service_ports p)) ]

def gp_service_tree = \i id g -> tree_node (gp_service_label (gp_payload id g) i id) [ (gp_workload_tree d g)
    | d <- (graph_out_of "Exposes" id g) ]

def gp_ingress_label = \i id -> gp_label ("Ingress " ++ (k8s_short id)) [ (gp_kv "hosts" (gp_hosts i))
    , (gp_kv "ip" (gp_ip i)) ]

def gp_ingress_tree = \g i -> tree_node (gp_ingress_label i (k8s_id_of i)) [ (gp_service_tree i s g)
    | s <- (graph_out_of "RoutesTo" (k8s_id_of i) g) ]

-- One tree per Ingress, under a single root so `visualize` shows them together.
def gp_trees = \g -> tree_node "ingresses" [ (gp_ingress_tree g i)
    | i <- (graph_payloads_of "Ingress" g) ]
