-- ==========================================================
-- gatwd Exhaustive DSL Test Suite
-- Run: ./gatwd tests/dsl_exhaustive_test.gatwd
-- This file acts as a self-asserting unit test for the DSL grammar.
-- If any pipeline evaluates incorrectly, the `assert` keyword will yield a Left(error).
-- ==========================================================
type IntVal = Int
type StrVal = String
type FloatVal = Float
type BigIntVal = BigInt
type UintVal = Uint
type ComplexVal = Complex
type ListVal = List(Int)

-- 1. Primitive Type Spawning and Pure Math Adapters
spawn IntVal: 10 |> math_add 5 |> assert 15
spawn IntVal: 100 |> math_add 100 |> assert 200

-- 2. Applicative Kleisli FanOut (&&&) - Tuple formation
spawn IntVal: 10 |> (math_add 10 &&& math_add 20) |> format_tuple "%v,%v" |> assert 20,30

-- 3. Applicative Split (***) - Parallel tuple mapping
spawn IntVal: 10 |> (math_add 10 &&& math_add 20) |> [math_add 10 *** math_add 10] |> format_tuple "%v,%v" |> assert 30,40

-- 4. Functional Iterators and Monadic Map Closure (flatMap)
spawn IntVal: 10 |> map (\x -> math_add 5 |> math_add 5) |> assert 20

-- 5. Pattern Matching (Catamorphisms) Routing
spawn IntVal: 99 |> match { 99 -> math_add 1 |> math_add 2 } |> assert 102

-- 6. Immutable Collections: Set
spawn StrVal: Start |> emit dup, unique, dup |> to_set |> assert Set

-- 7. Comonadic File System Traversal
-- `down` enters `examples/tour/01_basics.gatwd` (alphabetically first)
spawn StrVal: Start |> walk_fs examples/tour |> into_zipper |> down |> extract |> assert examples/tour/01_basics.gatwd


-- 8. Let Bindings (Variable substitution)
let x = spawn IntVal: 5 |> math_add 5 in spawn IntVal: x |> math_add 10 |> assert 20

-- 9. Def Macros (Compile-time expansion)
def add20 = math_add 10 |> math_add 10
spawn IntVal: 5 |> add20 |> assert 25

-- 10. Recursive Macros (Runtime lazy expansion)
def countdown = match { 0 -> math_add 100 | _ -> math_sub 1 |> countdown }
spawn IntVal: 5 |> countdown |> assert 100

-- 11. Algebraic Data Type List Destructuring (Quicksort with List Comprehensions)
def quicksort = match {
    [] -> empty
    | [pivot, ...rest] -> seq { [x | x <- rest, x < pivot] |> quicksort | pivot | [x | x <- rest, x >= pivot] |> quicksort }
}
spawn IntVal: 0 |> emit 5, 2, 8, 1, 9, 3 |> drop 1 |> collect_list |> quicksort |> collect_list |> assert [1 2 3 5 8 9]

-- 11b. Tuple/List Destructuring & Non-Primitive Recursion (Ackermann Function)
def ackermann = match {
    [0, n] -> n + 1
    | [m, 0] -> [m - 1, 1] |> ackermann
    | [m, n] -> let res = [m, n - 1] |> ackermann in [m - 1, res] |> ackermann
}
[2, 2] |> ackermann |> assert 7

-- 12. Script Constants (const declaration and pipeline substitution)
const TAX_BASE = 50
const SURCHARGE = 15
spawn IntVal: TAX_BASE |> math_add SURCHARGE |> assert 65

-- 13. Persistent HAMT Dictionary (to_hamt, hamt_get)
spawn StrVal: Start |> emit user:alice, role:admin |> to_hamt |> hamt_get role |> assert admin

-- 13b. Dotted-path accessor (hamt_path): deep field access over HAMT and Record
-- carriers — the composed-optic generalization of hamt_get. Single-level here
-- (DSL cannot yet build a nested HAMT; deep navigation is asserted in Go:
-- evaluator.TestStepHAMTPath / ExampleStepHAMTPath / optics.ExampleHAMTPathLens).
spawn StrVal: Start |> emit user:alice, role:admin |> to_hamt |> hamt_path role |> assert admin
spawn StrVal: Start |> echo "drwx root 4096 Jan 1 secret_file" |> parse_record Perms Owner Size Month Day Name |> hamt_path Owner |> assert root

-- 14. Stream Head & Tail Operators
spawn IntVal: 0 |> emit 10, 20, 30 |> drop 1 |> head |> assert 10
spawn IntVal: 0 |> emit 10, 20, 30 |> drop 1 |> tail |> head |> assert 20

-- 15. Stream Telemetry Transducer
spawn IntVal: 10 |> telemetry |> math_add 5 |> assert 15

-- 16. Eager Memory Chunks (chunking stream into bounded arrays)
spawn IntVal: 0 |> emit 1, 2, 3, 4 |> drop 1 |> chunk 2 |> head |> assert [1 2]

-- 17. Stream Checkpointing and Continuations
spawn IntVal: 0 |> emit 1, 2, 3 |> drop 1 |> checkpoint job_dsl 2 |> math_add 10 |> head |> assert 11

-- 18. File Scanner Adapter (generalized Scanner integration)
spawn StrVal: Start |> scan_file examples/tour/data/data1.txt |> head |> assert M

-- 19. Mock Stream Generator (lazy synthetic data generation)
spawn IntVal: 0 |> mock_stream 3 |> math_add 10 |> collect_list |> assert [10 11 12]

-- 20. Mock Users Struct Generator (structured domain types in DSL)
spawn StrVal: Start |> mock_users 2 |> head |> assert {0 admin_A admin 0 true}

-- 21. Unordered Output Assertion (permutation-invariant matching)
spawn IntVal: 0 |> emit 20, 10 |> drop 1 |> assert_unordered 10, 20 |> assert PASS

-- 22. Testable Example Output Validation (ordered matching)
spawn IntVal: 0 |> emit 10, 20 |> drop 1 |> example_test 10, 20 |> assert PASS

-- 23. HAMT Set Modification (immutable structural sharing update)
spawn StrVal: Start |> emit user:alice |> to_hamt |> hamt_set env prod |> hamt_get env |> assert prod

-- 24. HAMT Delete Modification (immutable key deletion)
spawn StrVal: Start |> emit a:1, b:2 |> to_hamt |> hamt_del a |> hamt_get b |> assert 2

-- 25. Set Add & Contains (immutable Set membership)
spawn StrVal: Start |> emit ruby |> to_set |> set_add golang |> set_contains golang |> assert true

-- 26. Chunk Unpack Transducer (unchunk roundtrip)
spawn IntVal: 0 |> emit 10, 20, 30 |> drop 1 |> chunk 2 |> unchunk |> collect_list |> assert [10 20 30]

-- 27. Word-Level Scanner Adapter (bufio.ScanWords integration)
spawn StrVal: Start |> scan_words examples/tour/data/data1.txt |> head |> assert M

-- 28. Optics Lens (focus and update)
spawn StrVal: Start |> echo "drwx root 4096 Jan 1 secret_file" |> parse_record Perms Owner Size Month Day Name |> update Owner admin |> focus Owner |> assert admin

-- 29. HAMT Keys & Values
spawn StrVal: Start |> emit k1:v1 |> drop 1 |> to_hamt |> hamt_keys |> assert k1
spawn StrVal: Start |> emit k1:v1 |> drop 1 |> to_hamt |> hamt_values |> assert v1

-- 30. Set Remove & Elements
spawn StrVal: Start |> emit a, b |> drop 1 |> to_set |> set_remove a |> set_contains a |> assert false
spawn StrVal: Start |> emit single_item |> drop 1 |> to_set |> set_elements |> assert single_item

-- 31. Stream Fold (Catamorphism)
spawn IntVal: 0 |> emit 1, 2, 3 |> drop 1 |> fold count |> assert 3

-- 32. Stream Distinct (Deduplication)
spawn IntVal: 0 |> emit 5, 5, 10, 10 |> drop 1 |> distinct |> collect_list |> assert [5 10]

-- 33. Stream Filter Predicate
spawn StrVal: Start |> emit alpha, beta, gamma |> drop 1 |> filter bet |> assert beta

-- 34. Visualizer UTF-8 Card Pipeline Formatting
spawn StrVal: Start |> echo "TestBox" |> visualize --curved --border --border-color=yellow |> assert ╭─────────────────────╮\n│ ╰─ Type(0): TestBox │\n╰─────────────────────╯

-- 35. Full Infix Arithmetic with Precedence & Division Float Promotion
spawn FloatVal: 7 / 2 |> assert 3.5
spawn IntVal: 7 // 2 |> assert 3
spawn IntVal: 2 + 3 * 4 |> assert 14
spawn IntVal: (2 + 3) * 4 |> assert 20

-- 36. Infix In Let Bindings
let calc = 100 / 4 + 5 in spawn FloatVal: calc |> assert 30

-- 37. Operator Sections in Pipelines
spawn IntVal: 10 |> * 5 |> assert 50
spawn IntVal: 7 |> / 2 |> assert 3.5
spawn IntVal: 10 |> - 3 |> assert 7

-- 38. Automatic Overflow Promotion to BigInt
spawn BigIntVal: 9223372036854775807 + 1 |> assert 9223372036854775808

-- 39. String Concatenation Operator (++)
spawn StrVal: "Hello " ++ "Gatwd" |> assert Hello Gatwd

-- 40. Boolean Logic Infix Evaluation
spawn StrVal: (5 < 10 && 3 == 3) |> assert true

-- 41. Uint Overflow Promotion to BigInt
spawn BigIntVal: 18446744073709551615 + 1 |> assert 18446744073709551616

-- 42. Complex Number Arithmetic with Infix Overloading
spawn ComplexVal: 1+2i + 3+4i |> assert (4+6i)

-- 43. List Comprehensions [expr | var <- source, filter...]
spawn ListVal: [x * 2 | x <- [1, 2, 3, 4], x > 2] |> assert [6 8]

-- 44. Dynamic EBNF Parser Transducer (Meta-Grammar Engine)
spawn StrVal: "k := 42" |> ebnf_parse Assignment "Assignment = Var \":=\" Value ; Var = \"k\" ; Value = \"42\" ;" |> assert &{sequence  [{Var  [{terminal k []}]} {terminal := []} {Value  [{terminal 42 []}]}]}

-- 45. Extended Stream Folds (sum, product, min, max, concat)
spawn IntVal: 0 |> emit 10, 20, 30 |> drop 1 |> fold sum |> assert 60
spawn IntVal: 0 |> emit 2, 3, 4 |> drop 1 |> fold product |> assert 24
spawn IntVal: 0 |> emit 50, 15, 80 |> drop 1 |> fold min |> assert 15
spawn IntVal: 0 |> emit 50, 15, 80 |> drop 1 |> fold max |> assert 80

-- 46. Higher-Order Functor Mapping over Streams and Persistent Lists
spawn IntVal: 0 |> emit 1, 2, 3 |> drop 1 |> map (\x -> x * 10) |> collect_list |> assert [10 20 30]
let xs = [1, 2, 3] in xs |> map (\x -> x + 5) |> assert [6 7 8]

-- 47. Set Algebra Builtins (Union, Intersect, Diff)
spawn StrVal: Start |> emit 1, 2 |> drop 1 |> to_set |> set_add 3 |> set_contains 3 |> assert true
let sA = (spawn StrVal: Start |> emit 1, 2 |> drop 1 |> to_set) in let sB = (spawn StrVal: Start |> emit 2, 3 |> drop 1 |> to_set) in sA |> set_intersect sB |> set_contains 2 |> assert true
let s1 = (spawn StrVal: Start |> emit 1, 2 |> drop 1 |> to_set) in let s2 = (spawn StrVal: Start |> emit 2, 3 |> drop 1 |> to_set) in s1 |> set_diff s2 |> set_contains 1 |> assert true

-- 48. Monoidal Concatenation (++) across Lists
let lA = [1, 2] in let lB = [3, 4] in (lA ++ lB) |> assert [1 2 3 4]

let seq1 = [1, 2] in let seq2 = [1, 3] in (seq1 < seq2) |> assert true

-- 50. Stream Aggregation into Persistent List and Contiguous Chunk
spawn IntVal: 0 |> emit 10, 20, 30 |> drop 1 |> to_list |> assert [10 20 30]
spawn IntVal: 0 |> emit 40, 50, 60 |> drop 1 |> to_chunk |> assert [40 50 60]

-- 51. Predicate Filtering with Lambda Expressions over Collections
let items = [1, 2, 3, 4, 5] in items |> filter (\x -> x > 3) |> assert [4 5]

-- 52. Predicate Filtering with Lambda Expressions over Streams
spawn IntVal: 0 |> emit 2, 5, 8, 11 |> drop 1 |> filter (\x -> x > 6) |> to_list |> assert [8 11]

-- 53. Direct Folding of In-Flight Collection Nodes
let coll = [10, 20, 30, 40] in coll |> fold sum |> assert 100

-- 54. Algebraic Tuple Pair Swap
let tuple = [100, 200] in tuple |> pair_swap |> assert [200 100]

-- 55. Pure Reusable Conway Transition Macro (B3/S23 Oscillator Verification)
def cgol_step = match { live -> let nbrs = [[x + dx, y + dy] | [x, y] <- live, dx <- [-1, 0, 1], dy <- [-1, 0, 1], (dx != 0 || dy != 0)] in let pairs = nbrs |> frequencies |> hamt_pairs |> collect_list in let births = [pt | [pt, cnt] <- pairs, cnt == 3] in let survivors = [p | [pt, cnt] <- pairs, p <- live, cnt == 2, p == pt] in births ++ survivors }
let blinker = [[2, 1], [2, 2], [2, 3]] in let gen1 = blinker |> cgol_step in gen1 |> unchunk |> fold count |> assert 3
let blinker = [[2, 1], [2, 2], [2, 3]] in let gen1 = blinker |> cgol_step in gen1 |> unchunk |> to_set |> set_contains [1 2] |> assert true
let blinker = [[2, 1], [2, 2], [2, 3]] in let gen2 = blinker |> cgol_step |> cgol_step in gen2 |> unchunk |> to_set |> set_contains [2 1] |> assert true

-- 56. ADT Constructor Pattern Matching (each sum-type branch routes to its own arm)
type Signal = SRed | SGreen | SYellow
spawn Signal: SGreen |> match { SRed -> echo STOP | SGreen -> echo GO | SYellow -> echo WAIT } |> assert GO
spawn Signal: SRed |> match { SRed -> echo STOP | SGreen -> echo GO | SYellow -> echo WAIT } |> assert STOP
spawn Signal: SYellow |> match { SRed -> echo STOP | SGreen -> echo GO | SYellow -> echo WAIT } |> assert WAIT

-- 57. First-Class Lambda Functions (lambda-bodied def, direct lambda step, composition, let-bound)
def l_inc = \x -> x + 1
def l_dbl = \x -> x * 2
spawn IntVal: 5 |> l_inc |> assert 6
spawn IntVal: 5 |> l_inc |> l_dbl |> assert 12
spawn IntVal: 5 |> (\x -> x * 10) |> assert 50
let lf = \x -> x + 100 in spawn IntVal: 5 |> lf |> assert 105
let xs = [1, 2, 3] in xs |> map l_dbl |> assert [2 4 6]

-- 58. Reject (negated filter) across List, stream, and Set
let rl = [1, 2, 3, 4, 5] in rl |> reject (\x -> x > 3) |> assert [1 2 3]
spawn IntVal: 0 |> emit 2, 5, 8, 11 |> drop 1 |> reject (\x -> x > 6) |> to_list |> assert [2 5]
spawn StrVal: s |> emit keep, drop, keep2 |> drop 1 |> reject (\x -> x == "drop") |> to_list |> assert [keep keep2]

-- 59. HAMT set-algebra: Intersect (keyed) and Diff (keyed)
let hi = spawn S: x |> emit a:1, c:3 |> drop 1 |> to_hamt in spawn S: x |> emit a:1, b:2 |> drop 1 |> to_hamt |> hamt_intersect hi |> hamt_keys |> collect_list |> assert [a]
let hd = spawn S: x |> emit a:1, c:3 |> drop 1 |> to_hamt in spawn S: x |> emit a:1, b:2 |> drop 1 |> to_hamt |> hamt_diff hd |> hamt_keys |> collect_list |> assert [b]

-- 60. Tree.Filter / Reject (prune child subtrees by predicate)
spawn S: Root |> emit 1, 5, 2, 8 |> drop 1 |> build_tree Root |> reject (\x -> x > 4) |> tree_size |> assert 3
spawn S: Root |> emit 1, 5, 2, 8 |> drop 1 |> build_tree Root |> filter (\x -> x > 4) |> tree_size |> assert 3

-- 61. flatMap / bind: monadic flatten over List and stream
let fl = [1, 2, 3] in fl |> flatmap (\x -> [x, x]) |> assert [1 1 2 2 3 3]
spawn IntVal: 0 |> emit 1, 2 |> drop 1 |> flatmap (\x -> [x, x]) |> collect_list |> assert [1 1 2 2]

-- 62. HAMT.Filter / Reject wired to the DSL (filter entries by value)
let hf = spawn S: x |> emit a:yes, b:no, c:no |> drop 1 |> to_hamt |> filter (\x -> x == "yes") |> hamt_keys |> collect_list in hf |> assert [a]
let hr = spawn S: x |> emit a:no, b:yes, c:no |> drop 1 |> to_hamt |> reject (\x -> x == "no") |> hamt_keys |> collect_list in hr |> assert [b]

-- 63. Custom-accumulator fold (fold (\acc x -> expr) seed) over List and stream
let cf = [1, 2, 3, 4] in cf |> fold (\acc x -> acc + x) 0 |> assert 10
spawn IntVal: 0 |> emit 2, 3, 4 |> drop 1 |> fold (\acc x -> acc * x) 1 |> assert 24

-- 64. Bimap (Bifunctor map) over a 2-element pair: left via e1, right via e2
let bp = [3, 4] in bp |> bimap (\x -> x + 10) (\y -> y * 2) |> assert [13 8]


-- 65. Graph collection: Graph(T) grammar + construction/projection builtins
type K8sGraph = Graph(String)
-- order (|V|) and size (|E|)
spawn S: x |> graph_empty |> graph_add_node Pod nginx |> graph_add_node Service web |> graph_add_edge Selects 1 web nginx |> graph_order |> assert 2
spawn S: x |> graph_empty |> graph_add_node Pod nginx |> graph_add_node Service web |> graph_add_edge Selects 1 web nginx |> graph_size |> assert 1
-- node & edge projection (deterministic order; edges as from-Color->to)
spawn S: x |> graph_empty |> graph_add_node N a |> graph_add_node N b |> graph_add_node N c |> graph_nodes |> collect_list |> assert [a b c]
spawn S: x |> graph_empty |> graph_add_node N a |> graph_add_node N b |> graph_add_edge Owns 1 a b |> graph_edges |> head |> assert a-Owns->b
-- adjacency: out / in / neighbors
spawn S: x |> graph_empty |> graph_add_node N a |> graph_add_node N b |> graph_add_edge Owns 1 a b |> graph_out a |> head |> assert b
spawn S: x |> graph_empty |> graph_add_node N a |> graph_add_node N b |> graph_add_edge Owns 1 a b |> graph_in b |> head |> assert a
-- nodes_of / edges_of by color
spawn S: x |> graph_empty |> graph_add_node Pod p |> graph_add_node Service s |> graph_nodes_of Pod |> head |> assert p
spawn S: x |> graph_empty |> graph_add_node N a |> graph_add_node N b |> graph_add_edge Owns 1 a b |> graph_add_edge Mounts 1 a b |> graph_edges_of Mounts |> head |> assert a-Mounts->b

-- 66. Graph fan-out grouping + inferred edges (§6 #8/#9)
spawn S: x |> graph_empty |> graph_add_node N svc |> graph_add_node N p1 |> graph_add_node N p2 |> graph_add_fanout Selects 1 svc p1 p2 |> graph_edges_of_group Selects:svc |> collect_list |> assert [svc-Selects->p1 svc-Selects->p2]
spawn S: x |> graph_empty |> graph_add_node N cm |> graph_add_node N svc |> graph_add_edge_inferred Consumes 0 cm svc |> graph_edges_inferred |> head |> assert cm-Consumes->svc
spawn S: x |> graph_empty |> graph_add_node N d |> graph_add_node N r1 |> graph_add_node N r2 |> graph_add_fanin Owns 1 d r1 r2 |> graph_edges_of_group Owns:d |> collect_list |> assert [r1-Owns->d r2-Owns->d]

-- 67. Graph walks & algorithms: reachable, BFS/DFS, shortest path, topo sort, SCC
spawn S: x |> graph_empty |> graph_add_node N a |> graph_add_node N b |> graph_add_node N c |> graph_add_edge E 1 a b |> graph_add_edge E 1 b c |> graph_reachable a |> collect_list |> assert [a b c]
spawn S: x |> graph_empty |> graph_add_node N a |> graph_add_node N b |> graph_add_node N c |> graph_add_edge E 1 a b |> graph_add_edge E 1 a c |> graph_bfs a |> head |> assert a
spawn S: x |> graph_empty |> graph_add_node N a |> graph_add_node N b |> graph_add_node N c |> graph_add_edge E 1 a b |> graph_add_edge E 2 b c |> graph_add_edge E 5 a c |> graph_shortest_path a c |> collect_list |> assert [a b c]
spawn S: x |> graph_empty |> graph_add_node N a |> graph_add_node N b |> graph_add_node N c |> graph_add_edge E 1 a b |> graph_add_edge E 1 b c |> graph_topo_sort |> collect_list |> assert [a b c]
spawn S: x |> graph_empty |> graph_add_node N a |> graph_add_node N b |> graph_add_edge E 1 a b |> graph_add_edge E 1 b a |> graph_scc |> head |> assert a,b

-- 68. Graph mutation: remove_node / remove_edge, and walk_from strategy
spawn S: x |> graph_empty |> graph_add_node N a |> graph_add_node N b |> graph_add_node N c |> graph_remove_node b |> graph_nodes |> collect_list |> assert [a c]
spawn S: x |> graph_empty |> graph_add_node N a |> graph_add_node N b |> graph_add_edge Owns 1 a b |> graph_remove_edge Owns a b |> graph_size |> assert 0
spawn S: x |> graph_empty |> graph_add_node N a |> graph_add_node N b |> graph_add_edge E 1 a b |> graph_walk_from a bfs |> collect_list |> assert [a b]

-- 69. Graph Functor: map_nodes / map_edges / bimap (verified via folds that read
-- the mapped payload/weight, since identity/endpoints are preserved)
spawn S: x |> graph_empty |> graph_add_node N a |> graph_add_node N b |> graph_add_node N c |> graph_map_nodes (\p -> 10) |> graph_fold_nodes (\acc p -> acc + p) 0 |> assert 30
spawn S: x |> graph_empty |> graph_add_node N a |> graph_add_node N b |> graph_add_node N c |> graph_add_edge E 1 a b |> graph_add_edge E 2 b c |> graph_map_edges (\w -> w * 10) |> graph_fold_edges (\acc w -> acc + w) 0 |> assert 30
spawn S: x |> graph_empty |> graph_add_node N a |> graph_add_node N b |> graph_add_edge E 1 a b |> graph_bimap (\p -> 20) (\w -> 5) |> graph_fold_edges (\acc w -> acc + w) 0 |> assert 5

-- 70. Graph Filterable: filter_nodes (vertex-induced subgraph) / filter_edges
spawn S: x |> graph_empty |> graph_add_node N a |> graph_add_node N b |> graph_add_node N c |> graph_filter_nodes (\p -> p == "b") |> graph_nodes |> collect_list |> assert [b]
spawn S: x |> graph_empty |> graph_add_node N a |> graph_add_node N b |> graph_add_node N c |> graph_add_edge E 1 a b |> graph_add_edge E 2 b c |> graph_filter_edges (\w -> w > 1) |> graph_size |> assert 1

-- 71. Graph Foldable (walk-ordered) + Monoid/set-algebra (union/intersect/diff)
spawn S: x |> graph_empty |> graph_add_node N a |> graph_add_node N b |> graph_add_node N c |> graph_add_edge E 1 a b |> graph_add_edge E 1 b c |> graph_fold_walk (\acc n -> acc + 1) 0 a |> assert 3
let gu = spawn S: x |> graph_empty |> graph_add_node N b |> graph_add_node N c in spawn S: x |> graph_empty |> graph_add_node N a |> graph_add_node N b |> graph_union gu |> graph_nodes |> collect_list |> assert [a b c]
let gi = spawn S: x |> graph_empty |> graph_add_node N b |> graph_add_node N c in spawn S: x |> graph_empty |> graph_add_node N a |> graph_add_node N b |> graph_intersect gi |> graph_nodes |> collect_list |> assert [b]
let gd = spawn S: x |> graph_empty |> graph_add_node N b |> graph_add_node N c in spawn S: x |> graph_empty |> graph_add_node N a |> graph_add_node N b |> graph_diff gd |> graph_nodes |> collect_list |> assert [a]

-- 72. Graph optics: single-node payload Lens — focus (read) / set / over (modify).
-- Distinct from the bulk Functor graph_map_nodes: these target ONE node, leaving
-- every sibling node and all edges untouched (structural sharing preserved).
spawn S: x |> graph_empty |> graph_add_node Pod nginx |> graph_focus nginx |> assert nginx
spawn S: x |> graph_empty |> graph_add_node Pod nginx |> graph_set nginx running |> graph_focus nginx |> assert running
spawn S: x |> graph_empty |> graph_add_node Pod nginx |> graph_set nginx 10 |> graph_over nginx (\p -> p + 5) |> graph_focus nginx |> assert 15
spawn S: x |> graph_empty |> graph_add_node N a |> graph_add_node N b |> graph_set a 1 |> graph_set b 2 |> graph_over a (\p -> p * 100) |> graph_focus b |> assert 2

-- 73. Graph ingest via fold with a GRAPH accumulator (anti-mockup ingest primitive).
-- A stream/list of records is folded into one persistent graph: the reducer applies
-- the graph-construction FUNCTIONS (graph_add_node / graph_add_edges), callable now
-- that the infix expression language supports juxtaposition application `f x y`.
-- This is how a crawled resource stream becomes a graph in pure DSL — no Go loop.
-- (a) fold a plain list of ids into nodes; the reducer returns the grown graph.
let ids = ["a", "b", "c"] in ids |> fold (\g r -> graph_add_node "N" r g) graph_empty |> graph_nodes |> collect_list |> assert [a b c]
-- (b) derive each node's color + id FROM a record payload via the hamt_get function
-- form, keeping the whole record as the node payload (the real ingest shape).
let r1 = spawn S: x |> emit kind:Pod, name:nginx |> drop 1 |> to_hamt in let r2 = spawn S: x |> emit kind:Service, name:web |> drop 1 |> to_hamt in [r1, r2] |> fold (\g x -> graph_add_node (hamt_get "kind" x) (hamt_get "name" x) x g) graph_empty |> graph_nodes |> collect_list |> assert [nginx web]
-- (c) the derived color is a real node color: project the Service-colored nodes.
let r1 = spawn S: x |> emit kind:Pod, name:nginx |> drop 1 |> to_hamt in let r2 = spawn S: x |> emit kind:Service, name:web |> drop 1 |> to_hamt in [r1, r2] |> fold (\g x -> graph_add_node (hamt_get "kind" x) (hamt_get "name" x) x g) graph_empty |> graph_nodes_of Service |> head |> assert web
-- (d) deep field access in the reducer via the hamt_path function form.
let r = spawn S: x |> emit kind:Pod, name:api |> drop 1 |> to_hamt in [r] |> fold (\g x -> graph_add_node (hamt_path "kind" x) (hamt_path "name" x) x g) graph_empty |> graph_nodes_of Pod |> head |> assert api
-- (e) edge ingest: a second fold adds a variable number of edges per element via a
-- destructuring comprehension feeding graph_add_edges (list of [color w from to]).
let es = [["a", "b"], ["b", "c"]] in es |> fold (\g e -> graph_add_edges [["Owns", 1, f, t] | [f, t] <- [e]] g) graph_empty |> graph_edges_of Owns |> collect_list |> assert [a-Owns->b b-Owns->c]

-- 74. Expression-level builtins resolve in ANY expression context (§3B), and bare
-- sum-type constructors resolve to their tag STRING in expressions (§5.1b).
-- (a) a bare top-level comprehension using the hamt_path function form over a record.
let rec = spawn S: x |> emit kind:Pod, name:nginx |> drop 1 |> to_hamt in [rec] |> fold (\g r -> graph_add_node (hamt_path "kind" r) (hamt_path "name" r) r g) graph_empty |> graph_nodes |> collect_list |> assert [nginx]
-- (b) a bare constructor (declared sum type) used as an edge color resolves to "Owns".
type EdgeColor = Owns | Selects | RoutesTo
let es = [["a", "b"], ["b", "c"]] in es |> fold (\g e -> graph_add_edges [[Owns, 1, f, t] | [f, t] <- [e]] g) graph_empty |> graph_edges_of Owns |> collect_list |> assert [a-Owns->b b-Owns->c]

-- 75. Generic subset_of (§5.2): Record/HAMT containment + Set/collection membership,
-- the honest primitive for the K8s Selects relation (selector ⊆ labels). Both the
-- pipeline-step form (subject |> subset_of operand) and the function form are wired.
-- (a) Set ⊆ Set — true then false.
let sup = (spawn S: x |> emit 1, 2, 3 |> drop 1 |> to_set) in spawn S: x |> emit 1, 2 |> drop 1 |> to_set |> subset_of sup |> assert true
let sup = (spawn S: x |> emit 1, 2, 3 |> drop 1 |> to_set) in spawn S: x |> emit 1, 4 |> drop 1 |> to_set |> subset_of sup |> assert false
-- (b) HAMT ⊆ HAMT by (key,value) — selector ⊆ labels, true then false.
let labels = (spawn S: x |> emit app:nginx, tier:web |> drop 1 |> to_hamt) in spawn S: x |> emit app:nginx |> drop 1 |> to_hamt |> subset_of labels |> assert true
let labels = (spawn S: x |> emit app:nginx |> drop 1 |> to_hamt) in spawn S: x |> emit app:other |> drop 1 |> to_hamt |> subset_of labels |> assert false
-- (c) the function form inside an expression (fold reducer): colors a node by whether
-- the selector is a subset of the labels, then projects the matching color.
let labels = spawn S: x |> emit app:nginx, tier:web |> drop 1 |> to_hamt in let sel = spawn S: x |> emit app:nginx |> drop 1 |> to_hamt in [sel] |> fold (\g s -> graph_add_node (subset_of s labels) "match" s g) graph_empty |> graph_nodes_of true |> collect_list |> assert [match]

-- 76. Expression-level graph read side + path-presence guard (generic, domain-free).
-- (a) graph_payloads: a graph stream element handed to a reducer as g exposes every node payload.
let ids = ["a", "b", "c"] in ids |> fold (\g r -> graph_add_node "N" r g) graph_empty |> fold (\_ g -> graph_payloads g) 0 |> assert [a b c]
-- (b) graph_payloads_of: only the payloads of one node color.
let r1 = spawn S: x |> emit kind:Pod, name:nginx |> drop 1 |> to_hamt in let r2 = spawn S: x |> emit kind:Service, name:web |> drop 1 |> to_hamt in [r1, r2] |> fold (\g x -> graph_add_node (hamt_get "kind" x) (hamt_get "name" x) x g) graph_empty |> fold (\_ g -> [ hamt_get "name" p | p <- (graph_payloads_of "Service" g) ]) 0 |> assert [web]
-- (c) hamt_has_path: true for a present key, false for a missing one.
let r = spawn S: x |> emit kind:Pod, name:api |> drop 1 |> to_hamt in [r] |> fold (\a x -> hamt_has_path "kind" x) false |> assert true
let r = spawn S: x |> emit kind:Pod, name:api |> drop 1 |> to_hamt in [r] |> fold (\a x -> hamt_has_path "missing" x) true |> assert false
-- (d) a guard between generators prunes before the next generator runs; unchanged semantics.
[ y | x <- [1, 2, 3], x > 1, y <- [x, x] ] |> assert [2 2 3 3]

-- 77. graph_in_of / graph_out_of (generic, domain-free): the colour-filtered
-- reverse/forward adjacency as an expression, so a comprehension can test "does any
-- edge of this colour enter/leave x?" (an empty list means none).
-- (a) incoming and outgoing neighbours of one colour, ignoring other colours.
let es = [["a", "b"], ["b", "c"]] in es |> fold (\g e -> graph_add_edges [[Owns, 1, f, t] | [f, t] <- [e]] g) graph_empty |> fold (\_ g -> graph_in_of Owns "b" g) 0 |> assert [a]
let es = [["a", "b"], ["b", "c"]] in es |> fold (\g e -> graph_add_edges [[Owns, 1, f, t] | [f, t] <- [e]] g) graph_empty |> fold (\_ g -> graph_out_of Owns "b" g) 0 |> assert [c]
let es = [["a", "b"]] in es |> fold (\g e -> graph_add_edges [[Owns, 1, f, t] | [f, t] <- [e]] g) graph_empty |> fold (\_ g -> graph_in_of Selects "b" g) 0 |> assert []
-- (b) used as a guard: the nodes no Owns edge enters (roots).
let es = [["a", "b"], ["b", "c"]] in es |> fold (\g e -> graph_add_edges [[Owns, 1, f, t] | [f, t] <- [e]] g) graph_empty |> fold (\_ g -> [ n | n <- ["a", "b", "c"], (graph_in_of Owns n g) == [] ]) 0 |> assert [a]

-- 78. First-class Closure values (Workstream B): lambdas as expression values with
-- multi-argument abstraction, currying/partial application, lexical capture, and
-- closures accepted by map/filter/reject/fold wherever an inline lambda is.
def c_add = \x y -> x + y
def c_pos = \x -> x > 0
def c_mkadder = \k -> \x -> x + k
-- (a) multi-argument application in expression position.
c_add 1 2 |> assert 3
-- (b) currying: a closure applied to fewer arguments than its arity is a function.
(c_add 10) 5 |> assert 15
-- (c) over-application through a returned closure (a function that returns a function).
c_mkadder 5 10 |> assert 15
-- (d) pipeline position applies the closure with the incoming value LAST.
spawn IntVal: 5 |> c_add 3 |> assert 8
-- (e) partial application is a value: let-bound, then used as a pipeline step and as a map argument.
let add100 = c_add 100 in spawn IntVal: 1 |> add100 |> assert 101
let add7 = c_mkadder 7 in [1, 2] |> map add7 |> assert [8 9]
-- (f) a closure value expression as a map argument.
[1, 2, 3] |> map (c_add 10) |> assert [11 12 13]
-- (g) a named binary closure is a fold reducer, with and without a seed.
[1, 2, 3] |> fold c_add 0 |> assert 6
[1, 2, 3] |> fold c_add |> assert 6
-- (h) a named predicate closure drives filter and reject across List.
[1, -2, 3] |> filter c_pos |> assert [1 3]
[1, -2, 3] |> reject c_pos |> assert [-2]
-- (i) let-bound multi-argument lambda value, applied with an explicit first argument.
let mul = \x y -> x * y in spawn IntVal: 6 |> mul 7 |> assert 42
-- (j) lexical capture: two closures from one factory keep distinct captured values.
let a5 = c_mkadder 5 in let a9 = c_mkadder 9 in [(a5 1), (a9 1)] |> assert [6 10]

-- 79. Expression-level function forms across the operator-type matrix (Workstream E).
-- Each cell is the FUNCTION form of an operation: arguments are computed runtime values
-- (not string tokens), types are preserved, and every function is curried.
-- (a) Functor / Filterable / Foldable / Monad over List.
map (\x -> x * 2) [1, 2, 3] |> assert [2 4 6]
filter (\x -> x > 1) [1, 2, 3] |> assert [2 3]
reject (\x -> x > 1) [1, 2, 3] |> assert [1]
fold (\a x -> a + x) 0 [1, 2, 3] |> assert 6
flatmap (\x -> [x, x]) [1, 2] |> assert [1 1 2 2]
-- (b) sequences: length/head/tail/nth/reverse/cons/concat/range/member/to_list.
length [1, 2, 3] |> assert 3
length "héllo" |> assert 5
head [7, 8, 9] |> assert 7
tail [7, 8, 9] |> assert [8 9]
nth 2 [7, 8, 9] |> assert 9
reverse [1, 2, 3] |> assert [3 2 1]
cons 0 [1, 2] |> assert [0 1 2]
concat [1] [2, 3] |> assert [1 2 3]
range 1 4 |> assert [1 2 3 4]
member 2 [1, 2, 3] |> assert true
member 9 [1, 2, 3] |> assert false
is_empty [] |> assert true
-- (c) Set: element types preserved (ints stay ints), set algebra, Functor/Filterable.
length (set_union (to_set [1, 2]) (to_set [2, 3])) |> assert 3
length (set_intersect (to_set [1, 2, 3]) (to_set [2, 3, 4])) |> assert 2
length (set_diff (to_set [1, 2, 3]) (to_set [2])) |> assert 2
set_contains 2 (set_add 2 set_empty) |> assert true
set_contains 2 (set_remove 2 (to_set [1, 2])) |> assert false
set_elements (to_set [7]) |> assert [7]
length (map (\x -> x * 0) (to_set [1, 2, 3])) |> assert 1
length (filter (\x -> x > 1) (to_set [1, 2, 3])) |> assert 2
fold (\a x -> a + x) 0 (to_set [1, 2, 3]) |> assert 6
-- (d) Chunk: Functor/Filterable/Foldable keep the carrier.
let c = (spawn IntVal: 0 |> emit 1, 2, 3 |> drop 1 |> to_chunk) in map (\x -> x * 2) c |> assert [2 4 6]
let c = (spawn IntVal: 0 |> emit 1, 2, 3 |> drop 1 |> to_chunk) in filter (\x -> x > 1) c |> assert [2 3]
let c = (spawn IntVal: 0 |> emit 1, 2, 3 |> drop 1 |> to_chunk) in fold (\a x -> a + x) 0 c |> assert 6
-- (e) HAMT: set/get/del/has/keys/values/pairs/merge/diff/intersect + Functor over values.
hamt_get "a" (hamt_set "a" 1 hamt_empty) |> assert 1
hamt_has "a" (hamt_set "a" 1 hamt_empty) |> assert true
hamt_has "a" (hamt_del "a" (hamt_set "a" 1 hamt_empty)) |> assert false
hamt_values (hamt_set "a" 5 hamt_empty) |> assert [5]
hamt_keys (hamt_set "a" 5 hamt_empty) |> assert [a]
fst (head (hamt_pairs (hamt_set "a" 5 hamt_empty))) |> assert a
hamt_get "b" (hamt_merge (hamt_from [["a", 1]]) (hamt_from [["b", 2]])) |> assert 2
length (hamt_diff (hamt_from [["a", 1], ["b", 2]]) (hamt_from [["a", 1]])) |> assert 1
length (hamt_intersect (hamt_from [["a", 1], ["b", 2]]) (hamt_from [["a", 1]])) |> assert 1
hamt_get "b" (map (\v -> v * 10) (hamt_from [["a", 1], ["b", 2]])) |> assert 20
length (filter (\v -> v > 1) (hamt_from [["a", 1], ["b", 2]])) |> assert 1
fold (\a v -> a + v) 0 (hamt_from [["a", 1], ["b", 2]]) |> assert 3
-- (f) Tree (rose tree): construction, projection, Functor/Filterable/Foldable.
tree_size (tree_node 1 [(tree_leaf 2), (tree_leaf 3)]) |> assert 3
tree_depth (tree_node 1 [(tree_leaf 2), (tree_leaf 3)]) |> assert 2
tree_flatten (tree_node 1 [(tree_leaf 2), (tree_leaf 3)]) |> assert [1 2 3]
tree_member 3 (tree_node 1 [(tree_leaf 2), (tree_leaf 3)]) |> assert true
tree_value (tree_add_child (tree_leaf 9) (tree_leaf 1)) |> assert 1
length (tree_children (tree_add_child (tree_leaf 9) (tree_leaf 1))) |> assert 1
tree_flatten (map (\x -> x * 2) (tree_node 1 [(tree_leaf 2), (tree_leaf 3)])) |> assert [2 4 6]
fold (\a x -> a + x) 0 (tree_node 1 [(tree_leaf 2), (tree_leaf 3)]) |> assert 6
-- (g) BST: ordered insert/membership, in-order fold.
to_list (bst_from [5, 2, 8, 1]) |> assert [1 2 5 8]
bst_member 8 (bst_from [5, 2, 8, 1]) |> assert true
bst_member 3 (bst_from [5, 2, 8, 1]) |> assert false
length (bst_insert 3 (bst_from [5, 2, 8, 1])) |> assert 5
fold (\a x -> a + x) 0 (bst_from [5, 2, 8, 1]) |> assert 16
-- (h) Pair: construct/project/swap, Functor over snd, Bifunctor.
fst (pair 1 "x") |> assert 1
snd (pair 1 "x") |> assert x
fst (pair_swap (pair 1 2)) |> assert 2
snd (map (\x -> x + 1) (pair "k" 1)) |> assert 2
snd (bimap (\a -> a + 1) (\b -> b * 2) (pair 1 5)) |> assert 10
-- (i) Maybe / Either.
maybe_default 0 (just 5) |> assert 5
maybe_default 0 nothing |> assert 0
is_just (just 1) |> assert true
is_nothing nothing |> assert true
maybe_default 0 (map (\x -> x + 1) (just 1)) |> assert 2
maybe_default 0 (flatmap (\x -> just (x * 3)) (just 2)) |> assert 6
maybe_default 0 (filter (\x -> x > 5) (just 2)) |> assert 0
maybe_fold 0 (\x -> x + 1) (just 4) |> assert 5
either_default 0 (either_right 4) |> assert 4
either_default 0 (either_left "bad") |> assert 0
is_left (either_left 1) |> assert true
is_right (either_left 1) |> assert false
either_fold (\e -> 0) (\x -> x + 1) (either_right 4) |> assert 5
either_default 0 (map (\x -> x + 1) (either_right 4)) |> assert 5
either_default 0 (flatmap (\x -> either_right (x * 2)) (either_right 4)) |> assert 8
either_default 7 (bimap (\e -> e) (\x -> x * 2) (either_left 1)) |> assert 7
-- (j) Variant: constructor application over a declared sum type, Functor over the payload.
type Shape = Circle | Square
variant_payload (variant "Circle" 3) |> assert 3
variant_tag (variant "Square" 1) |> assert Square
is_variant "Circle" (variant "Circle" 3) |> assert true
is_variant "Square" (variant "Circle" 3) |> assert false
variant_payload (map (\r -> r * 2) (variant "Circle" 3)) |> assert 6
-- (k) primitives.
min 3 7 |> assert 3
max 3 7 |> assert 7
abs (0 - 4) |> assert 4
negate 5 |> assert -5
compare 1 2 |> assert -1
-- (l) function forms compose inside lambdas, folds, comprehensions and partial application.
[ length x | x <- [[1], [1, 2]] ] |> assert [1 2]
[ set_contains y (to_set [1, 2]) | y <- [1, 3] ] |> assert [true false]
hamt_get "ab" (fold (\h w -> hamt_set w (length w) h) hamt_empty ["ab", "c"]) |> assert 2
map (hamt_get "a") [(hamt_from [["a", 1]]), (hamt_from [["a", 2]])] |> assert [1 2]
map (set_contains 2) [(to_set [1, 2]), (to_set [3])] |> assert [true false]
(fold (\a x -> a + x) 100) [1, 2] |> assert 103

-- 80. Optional type annotations on def (Workstream D1): advisory for `gatwd --check`,
-- never alter evaluation. Annotated and unannotated defs behave identically.
def a_inc : Int -> Int = \x -> x + 1
def a_add : Int -> Int -> Int = \x y -> x + y
a_inc 41 |> assert 42
spawn IntVal: 5 |> a_add 3 |> assert 8
[1, 2, 3] |> map (a_add 10) |> assert [11 12 13]

-- 81. ArrowPlus / MonadPlus choice (<+>): merge several sub-pipelines into ONE stream.
-- The incoming node runs through every branch; outputs concatenate in branch order.
spawn IntVal: 5 |> (math_add 1 <+> math_add 10 <+> math_add 100) |> collect_list |> assert [6 15 105]
-- A branch may itself be a pipeline; the merged stream feeds the rest of the pipeline.
spawn IntVal: 5 |> (math_add 1 |> math_add 1 <+> math_add 10) |> map (\x -> x * 2) |> collect_list |> assert [14 30]
-- Monoid identity/associativity: nesting changes nothing.
spawn IntVal: 1 |> ((math_add 1 <+> math_add 2) <+> math_add 3) |> collect_list |> assert [2 3 4]

-- 82. Graph function forms (generic, domain-free): read side + inferred edges, callable
-- inside a comprehension so a whole-graph algorithm can run as part of a rule.
-- Fixtures: a chain a -> b -> c with an isolated node d, and a cycle x <-> y -> z.
def g_chain = fold (\g n -> graph_add_node "N" n g) graph_empty |> fold (\_ g -> graph_add_edges [["Owns", 1, "a", "b"], ["Owns", 1, "b", "c"]] g) graph_empty
def g_cycle = fold (\g n -> graph_add_node "N" n g) graph_empty |> fold (\_ g -> graph_add_edges [["Owns", 1, "x", "y"], ["Owns", 1, "y", "x"], ["Owns", 1, "y", "z"]] g) graph_empty
-- (a) counts, membership, node ids.
["d", "c", "b", "a"] |> g_chain |> fold (\_ g -> graph_order g) 0 |> assert 4
["a", "b", "c"] |> g_chain |> fold (\_ g -> graph_size g) 0 |> assert 2
["a", "b", "c"] |> g_chain |> fold (\_ g -> graph_has_node "b" g) false |> assert true
["a", "b", "c"] |> g_chain |> fold (\_ g -> graph_has_node "z" g) true |> assert false
["c", "a", "b"] |> g_chain |> fold (\_ g -> graph_nodes g) 0 |> assert [a b c]
-- (b) edges: per-color pairs, reachability, shortest path, topological order.
["a", "b", "c"] |> g_chain |> fold (\_ g -> graph_edge_pairs "Owns" g) 0 |> assert [[a b] [b c]]
["a", "b", "c"] |> g_chain |> fold (\_ g -> graph_edge_pairs "Selects" g) 0 |> assert []
["a", "b", "c"] |> g_chain |> fold (\_ g -> graph_reachable "b" g) 0 |> assert [b c]
["a", "b", "c"] |> g_chain |> fold (\_ g -> graph_shortest_path "a" "c" g) 0 |> assert [a b c]
["a", "b", "c"] |> g_chain |> fold (\_ g -> graph_shortest_path "c" "a" g) 0 |> assert []
["a", "b", "c"] |> g_chain |> fold (\_ g -> graph_topo_sort g) 0 |> assert [a b c]
-- (c) cycles: no topological order exists; scc finds the component, and a rule can
-- keep only the non-trivial ones inside a comprehension.
["x", "y", "z"] |> g_cycle |> fold (\_ g -> graph_topo_sort g) 0 |> assert []
["x", "y", "z"] |> g_cycle |> fold (\_ g -> [ c | c <- (graph_scc g), (length c) > 1 ]) 0 |> assert [[x y]]
-- (d) inferred edges are tracked separately from asserted ones.
["a", "b"] |> fold (\g n -> graph_add_node "N" n g) graph_empty |> fold (\_ g -> graph_add_inferred_edges [["Calls", 0.5, "a", "b"]] g) graph_empty |> graph_edges_inferred |> collect_list |> assert [a-Calls->b]

-- 83. User closures and builtins are callable inside INLINE map/filter/flatmap lambdas
-- (the lambda body resolves names through the same environment as fold bodies).
def c2_add = \x y -> x + y
def c2_pos = \x -> x > 0
[1, 2, 3] |> map (\x -> c2_add x 10) |> assert [11 12 13]
[1, -2, 3] |> filter (\x -> c2_pos x) |> assert [1 3]
[1, -2, 3] |> reject (\x -> c2_pos x) |> assert [-2]
[1, 2] |> flatmap (\x -> [x, (c2_add x 10)]) |> assert [1 11 2 12]
[[1], [1, 2]] |> map (\x -> length x) |> assert [1 2]

-- 84. Fail-loud sweep (hardening W0): a top-level let binds the REAL value, so a
-- function form applied to a let-bound HAMT still sees a HAMT (not its `%v` text).
let w0_h = spawn StrVal: Start |> emit user:alice, role:admin |> to_hamt
hamt_get "role" w0_h |> assert admin
let w0_xs = [1, 2, 3]
w0_xs |> map (\x -> x * 2) |> assert [2 4 6]
-- A lambda that fails inside map/filter/fold becomes an [ERROR] node (asserted away
-- here by the surrounding negative-control tests in pkg/cli/failloud_test.go), and a
-- two-argument inline fold threads its accumulator through the shared closure path.
[1, 2, 3] |> fold (\a x -> a + x) 0 |> assert 6
[1, 2, 3] |> fold (\a x -> a * x) 1 |> assert 6

-- 85. ARGS / ARG0 (hardening D4): always defined; with no `--` arguments ARGS is the empty
-- list and ARG0 the script path (so a script can rely on them without a guard).
length ARGS |> assert 0
ARGS |> map (\a -> a ++ "!") |> assert []

-- 86. A bare literal is a valid pipeline head (it used to yield nothing), including with a
-- let-bound partial application.
def lh_add = \x y -> x + y
5 |> lh_add 1 |> assert 6
let lh_inc = lh_add 1 in 5 |> lh_inc |> assert 6

-- 87. Char (hardening W2, D1): a distinct code-point type with its own literal, ordering and
-- function forms. A Char is not an Int and not a String, but a one-character String converts
-- to a Char on demand wherever a Char is expected.
'a' == 'a' |> assert true
'a' < 'b' |> assert true
'a' == "a" |> assert true
'\n' == '\x0a' |> assert true
'é' == 'é' |> assert true
char_code 'a' |> assert 97
char_code "é" |> assert 233
char_from_code 98 == 'b' |> assert true
char_to_str 'x' |> assert x
-- inside lambdas and comprehensions (the function form is the DSL cell)
['a', 'b', 'c'] |> map (\c -> char_code c) |> assert [97 98 99]
['a', 'b', 'c'] |> map (\c -> (char_upper c) == 'A') |> assert [true false false]
['a', '1', 'B'] |> filter (\c -> char_is_alpha c) |> map (\c -> char_code c) |> assert [97 66]
['a', ' ', '7'] |> map (\c -> [(char_is_digit c), (char_is_space c)]) |> assert [[false false] [false true] [true false]]
['Q', 'q'] |> map (\c -> [(char_is_upper c), (char_is_lower c)]) |> assert [[true false] [false true]]
[ char_code c | c <- ['x', 'y'], c > 'x' ] |> assert [121]
fold (\acc c -> acc + (char_code c)) 0 ['a', 'b'] |> assert 195
-- Maybe, not an error, for malformed text
maybe_default 0 (map (\c -> char_code c) (char_of_str "z")) |> assert 122
maybe_default 0 (map (\c -> char_code c) (char_of_str "zz")) |> assert 0
is_just (char_of_str "z") |> assert true
is_just (char_of_str "zz") |> assert false
