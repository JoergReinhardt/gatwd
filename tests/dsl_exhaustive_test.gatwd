-- ==========================================================
-- gatwd Exhaustive DSL Test Suite
-- Run: ./gatwd tests/dsl_exhaustive_test.gatwd
-- This file acts as a self-asserting unit test for the DSL grammar.
-- If any pipeline evaluates incorrectly, the `assert` keyword will yield a Left(error).
-- ==========================================================
type IntVal = Int
type StrVal = String
type FloatVal = Float
type BigIntVal = BigInt
type UintVal = Uint
type ComplexVal = Complex
type ListVal = List(Int)

-- 1. Primitive Type Spawning and Pure Math Adapters
spawn IntVal: 10 |> math_add 5 |> assert 15
spawn IntVal: 100 |> math_add 100 |> assert 200

-- 2. Applicative Kleisli FanOut (&&&) - Tuple formation
spawn IntVal: 10 |> (math_add 10 &&& math_add 20) |> format_tuple "%v,%v" |> assert 20,30

-- 3. Applicative Split (***) - Parallel tuple mapping
spawn IntVal: 10 |> (math_add 10 &&& math_add 20) |> [math_add 10 *** math_add 10] |> format_tuple "%v,%v" |> assert 30,40

-- 4. Functional Iterators and Monadic Map Closure (flatMap)
spawn IntVal: 10 |> map (\x -> math_add 5 |> math_add 5) |> assert 20

-- 5. Pattern Matching (Catamorphisms) Routing
spawn IntVal: 99 |> match { 99 -> math_add 1 |> math_add 2 } |> assert 102

-- 6. Immutable Collections: Set
spawn StrVal: Start |> emit dup, unique, dup |> to_set |> assert Set

-- 7. Comonadic File System Traversal
-- `down` enters `examples/tour/01_basics.gatwd` (alphabetically first)
spawn StrVal: Start |> walk_fs examples/tour |> into_zipper |> down |> extract |> assert examples/tour/01_basics.gatwd


-- 8. Let Bindings (Variable substitution)
let x = spawn IntVal: 5 |> math_add 5 in spawn IntVal: x |> math_add 10 |> assert 20

-- 9. Def Macros (Compile-time expansion)
def add20 = math_add 10 |> math_add 10
spawn IntVal: 5 |> add20 |> assert 25

-- 10. Recursive Macros (Runtime lazy expansion)
def countdown = match { 0 -> math_add 100 | _ -> math_sub 1 |> countdown }
spawn IntVal: 5 |> countdown |> assert 100

-- 11. Algebraic Data Type List Destructuring (Quicksort)
def quicksort = match {
    [] -> empty
    | [pivot, ...rest] -> seq { rest |> filter_less pivot |> collect_list |> quicksort | pivot | rest |> filter_greater pivot |> collect_list |> quicksort }
}
spawn IntVal: 0 |> emit 5, 2, 8, 1, 9, 3 |> drop 1 |> collect_list |> quicksort |> collect_list |> assert [1 2 3 5 8 9]

-- 12. Script Constants (const declaration and pipeline substitution)
const TAX_BASE = 50
const SURCHARGE = 15
spawn IntVal: TAX_BASE |> math_add SURCHARGE |> assert 65

-- 13. Persistent HAMT Dictionary (to_hamt, hamt_get)
spawn StrVal: Start |> emit user:alice, role:admin |> to_hamt |> hamt_get role |> assert admin

-- 14. Stream Head & Tail Operators
spawn IntVal: 0 |> emit 10, 20, 30 |> drop 1 |> head |> assert 10
spawn IntVal: 0 |> emit 10, 20, 30 |> drop 1 |> tail |> head |> assert 20

-- 15. Stream Telemetry Transducer
spawn IntVal: 10 |> telemetry |> math_add 5 |> assert 15

-- 16. Eager Memory Chunks (chunking stream into bounded arrays)
spawn IntVal: 0 |> emit 1, 2, 3, 4 |> drop 1 |> chunk 2 |> head |> assert [1 2]

-- 17. Stream Checkpointing and Continuations
spawn IntVal: 0 |> emit 1, 2, 3 |> drop 1 |> checkpoint job_dsl 2 |> math_add 10 |> head |> assert 11

-- 18. File Scanner Adapter (generalized Scanner integration)
spawn StrVal: Start |> scan_file examples/tour/data/data1.txt |> head |> assert M

-- 19. Mock Stream Generator (lazy synthetic data generation)
spawn IntVal: 0 |> mock_stream 3 |> math_add 10 |> collect_list |> assert [10 11 12]

-- 20. Mock Users Struct Generator (structured domain types in DSL)
spawn StrVal: Start |> mock_users 2 |> head |> assert {0 admin_A admin 0 true}

-- 21. Unordered Output Assertion (permutation-invariant matching)
spawn IntVal: 0 |> emit 20, 10 |> drop 1 |> assert_unordered 10, 20 |> assert PASS

-- 22. Testable Example Output Validation (ordered matching)
spawn IntVal: 0 |> emit 10, 20 |> drop 1 |> example_test 10, 20 |> assert PASS

-- 23. HAMT Set Modification (immutable structural sharing update)
spawn StrVal: Start |> emit user:alice |> to_hamt |> hamt_set env prod |> hamt_get env |> assert prod

-- 24. HAMT Delete Modification (immutable key deletion)
spawn StrVal: Start |> emit a:1, b:2 |> to_hamt |> hamt_del a |> hamt_get b |> assert 2

-- 25. Set Add & Contains (immutable Set membership)
spawn StrVal: Start |> emit ruby |> to_set |> set_add golang |> set_contains golang |> assert true

-- 26. Chunk Unpack Transducer (unchunk roundtrip)
spawn IntVal: 0 |> emit 10, 20, 30 |> drop 1 |> chunk 2 |> unchunk |> collect_list |> assert [10 20 30]

-- 27. Word-Level Scanner Adapter (bufio.ScanWords integration)
spawn StrVal: Start |> scan_words examples/tour/data/data1.txt |> head |> assert M

-- 28. Optics Lens (focus and update)
spawn StrVal: Start |> echo "drwx root 4096 Jan 1 secret_file" |> parse_record Perms Owner Size Month Day Name |> update Owner admin |> focus Owner |> assert admin

-- 29. HAMT Keys & Values
spawn StrVal: Start |> emit k1:v1 |> drop 1 |> to_hamt |> hamt_keys |> assert k1
spawn StrVal: Start |> emit k1:v1 |> drop 1 |> to_hamt |> hamt_values |> assert v1

-- 30. Set Remove & Elements
spawn StrVal: Start |> emit a, b |> drop 1 |> to_set |> set_remove a |> set_contains a |> assert false
spawn StrVal: Start |> emit single_item |> drop 1 |> to_set |> set_elements |> assert single_item

-- 31. Stream Fold (Catamorphism)
spawn IntVal: 0 |> emit 1, 2, 3 |> drop 1 |> fold count |> assert 3

-- 32. Stream Distinct (Deduplication)
spawn IntVal: 0 |> emit 5, 5, 10, 10 |> drop 1 |> distinct |> collect_list |> assert [5 10]

-- 33. Stream Filter Predicate
spawn StrVal: Start |> emit alpha, beta, gamma |> drop 1 |> filter bet |> assert beta

-- 34. Visualizer UTF-8 Card Pipeline Formatting
spawn StrVal: Start |> echo "TestBox" |> visualize --curved --border --border-color=yellow |> assert ╭───────────────────────╮\n│ ╰─ Type(0): "TestBox" │\n╰───────────────────────╯

-- 35. Full Infix Arithmetic with Precedence & Division Float Promotion
spawn FloatVal: 7 / 2 |> assert 3.5
spawn IntVal: 7 // 2 |> assert 3
spawn IntVal: 2 + 3 * 4 |> assert 14
spawn IntVal: (2 + 3) * 4 |> assert 20

-- 36. Infix In Let Bindings
let calc = 100 / 4 + 5 in spawn FloatVal: calc |> assert 30

-- 37. Operator Sections in Pipelines
spawn IntVal: 10 |> * 5 |> assert 50
spawn IntVal: 7 |> / 2 |> assert 3.5
spawn IntVal: 10 |> - 3 |> assert 7

-- 38. Automatic Overflow Promotion to BigInt
spawn BigIntVal: 9223372036854775807 + 1 |> assert 9223372036854775808

-- 39. String Concatenation Operator (++)
spawn StrVal: "Hello " ++ "Gatwd" |> assert Hello Gatwd

-- 40. Boolean Logic Infix Evaluation
spawn StrVal: (5 < 10 && 3 == 3) |> assert true

-- 41. Uint Overflow Promotion to BigInt
spawn BigIntVal: 18446744073709551615 + 1 |> assert 18446744073709551616

-- 42. Complex Number Arithmetic with Infix Overloading
spawn ComplexVal: 1+2i + 3+4i |> assert (4+6i)

-- 43. List Comprehensions [expr | var <- source, filter...]
spawn ListVal: [x * 2 | x <- [1, 2, 3, 4], x > 2] |> assert [6 8]

