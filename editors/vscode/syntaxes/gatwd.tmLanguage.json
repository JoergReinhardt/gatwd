{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "fileTypes": [
    "gatwd"
  ],
  "name": "Gatwd",
  "patterns": [
    {
      "match": "--.*$",
      "name": "comment.line.double-dash.gatwd"
    },
    {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.gatwd",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.gatwd"
        }
      ]
    },
    {
      "match": "\\b(def|spawn|type|const|let|in|match|seq|import|empty)\\b",
      "name": "keyword.control.gatwd"
    },
    {
      "match": "\\b(Int|String|Float|BigInt|BigFloat|Complex|Uint|Bool|List|Set|Tree|BST|BTree|RBTree|Pair|Tuple)\\b",
      "name": "entity.name.type.gatwd"
    },
    {
      "match": "\\b(take|drop|head|tail|distinct|fold|memoize|map|filter|filter_less|filter_greater|sort|emit|chunk|unchunk|collect_list|to_hamt|hamt_get|hamt_set|hamt_del|hamt_keys|hamt_values|to_set|set_add|set_contains|set_remove|set_elements|parse_record|focus|update|build_tree|into_zipper|down|up|left|right|extract|zip|format_tuple|assert|expect|debug_print|visualize|telemetry|checkpoint|ebnf_parse)\\b",
      "name": "support.function.builtin.gatwd"
    },
    {
      "match": "\\|\u003e|\\|\\|\u003e|⊳",
      "name": "keyword.operator.pipe.gatwd"
    },
    {
      "match": "-\u003e|\u003c-|→",
      "name": "keyword.operator.arrow.gatwd"
    },
    {
      "match": "\u0026\u0026\u0026|\\*\\*\\*",
      "name": "keyword.operator.arrows.gatwd"
    },
    {
      "match": "(\\+|\\-|\\*|\\/|\\/\\/|\\%|\\+\\+|==|!=|\u003c=|\u003e=|\u003c|\u003e|\u0026\u0026|\\|\\|)",
      "name": "keyword.operator.math.gatwd"
    },
    {
      "match": "\\b[0-9]+(\\.[0-9]+)?(i)?\\b",
      "name": "constant.numeric.gatwd"
    }
  ],
  "scopeName": "source.gatwd"
}
