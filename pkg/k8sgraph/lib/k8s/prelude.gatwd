-- Single embed entry point of the Kubernetes graph library.
import "types.gatwd"
import "ids.gatwd"
import "ingest.gatwd"
import "relations.gatwd"
import "sources.gatwd"
import "queries.gatwd"
import "parity.gatwd"

-- A resource stream lifted to a typed graph with every relation derived:
--   spawn StrVal: ./manifests |> manifests |> k8s_graph
def k8s_graph = k8s_ingest |> k8s_relations
