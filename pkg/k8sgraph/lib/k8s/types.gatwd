-- Kubernetes graph vocabulary: node colors (resource kinds, exactly as they appear in
-- a manifest's `kind`) and edge colors (relations). Extend either sum type to add a
-- new kind/relation; no Go change is needed.
type NodeColor = Pod | Service | Ingress | ConfigMap | Secret | Deployment | ReplicaSet | PersistentVolumeClaim | ServiceAccount | Role | RoleBinding
type EdgeColor = Selects | RoutesTo | Configures | Owns | Mounts | Binds | Calls
