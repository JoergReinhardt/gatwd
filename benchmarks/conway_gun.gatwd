-- ==============================================================================
-- Conway's Game of Life — 100% pure gatwd performance / leak probe
-- ==============================================================================
-- Runs on the STOCK `gatwd` binary. No Go harness, no custom steps, no embedded
-- strings — the rule AND the generational loop are both pure DSL.
--
--   ./gatwd benchmarks/conway_gun.gatwd
--
-- Seed: a field of Gosper glider guns (an unbounded-growth pattern), so the
-- population stays large and lively for the whole run instead of settling like a
-- random soup. Each step does heavy sparse work — Moore-neighbourhood expansion,
-- HAMT frequency counting, birth/survivor comprehensions — making this an
-- allocation-heavy interpreter probe. Change GENS below to scale the runtime
-- (~0.2s/gen at this field size; 100 gens ≈ 20s, flat ~18 MB RSS).
-- ==============================================================================

type Cell = [Int]

-- B3/S23 transition on a sparse set of live coordinates.
def conway_step = match {
    live -> let nbrs = [[x + dx, y + dy] | [x, y] <- live, dx <- [-1, 0, 1], dy <- [-1, 0, 1], (dx != 0 || dy != 0)]
            in let pairs = nbrs |> frequencies |> hamt_pairs |> collect_list
            in let births = [pt | [pt, cnt] <- pairs, cnt == 3]
            in let survivors = [p | [pt, cnt] <- pairs, p <- live, cnt == 2, p == pt]
            in births ++ survivors
}

-- Iterate conway_step n times, purely by recursion (same shape as ackermann).
-- `to_chunk` re-collapses the match-bound (streamed) state into a single board
-- before each step — without it, conway_step is applied cell-by-cell and dies.
def evolve = match {
    [state, 0] -> state
    | [state, n] -> let next = state |> to_chunk |> conway_step in [next, n - 1] |> evolve
}

-- --- Correctness: a blinker has period 2; a glider survives and translates. ---
let blinker = [[2, 1], [2, 2], [2, 3]]
[blinker, 20] |> evolve |> to_chunk |> unchunk |> fold count |> assert 3

let glider = [[2, 1], [3, 2], [1, 3], [2, 3], [3, 3]]
[glider, 40] |> evolve |> to_chunk |> unchunk |> fold count |> assert 5

-- --- Workload: a 6-gun field, tiled purely in-DSL by offsetting one gun. ---
let gun = [[24, 0], [22, 1], [24, 1], [12, 2], [13, 2], [20, 2], [21, 2], [34, 2], [35, 2], [11, 3], [15, 3], [20, 3], [21, 3], [34, 3], [35, 3], [0, 4], [1, 4], [10, 4], [16, 4], [20, 4], [21, 4], [0, 5], [1, 5], [10, 5], [14, 5], [16, 5], [17, 5], [22, 5], [24, 5], [10, 6], [16, 6], [24, 6], [11, 7], [15, 7], [12, 8], [13, 8]]
let field = [[x + ox, y + oy] | [x, y] <- gun, [ox, oy] <- [[0, 0], [60, 0], [120, 0], [0, 60], [60, 60], [120, 60]]]

-- Evolve the field GENS generations; print the final live-cell count.
[field, 100] |> evolve |> to_chunk |> unchunk |> fold count
