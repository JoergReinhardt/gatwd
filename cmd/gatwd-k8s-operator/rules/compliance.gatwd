-- Use-case rules of the Kubernetes compliance operator. They run over the typed
-- graph the embedded k8s prelude derives (k8s_graph) and are the part an operator
-- hot-reloads from a ConfigMap. Each rule is a closure from the graph to a list of
-- [violation, resource, message] triples (the message is the optional third
-- element); an empty list means the cluster is compliant. The resource is the qualified node id Kind/namespace/name (k8s_short id is its name).
--
--   UnselectedPod:    a Pod that no Service selects, so it receives no traffic.
--   IdleDeployment:   a Deployment that owns no ReplicaSet, so it manages no Pods.
--   UnusedService:    a Service with a selector that selects no Pod.
--   DanglingIngress:  an Ingress routing to a Service that does not exist.
--   MissingConfigMap: a Pod/Deployment referencing a ConfigMap that does not exist.
--   DependencyCycle:  resources that (transitively) own/depend on each other; the
--                     resource is the list of ids in the strongly connected component.
--
-- Usage over one resource stream:
--   spawn StrVal: ./manifests |> manifests |> compliance        (offline)
--   spawn StrVal: default |> k8s_resources |> compliance        (live cluster)

def rule_unselected_pod = \g -> [ ["UnselectedPod", pid, "no Service selects this Pod, so it receives no traffic"]
  | p <- (graph_payloads_of "Pod" g)
  , pid <- [ (k8s_id_of p) ]
  , (graph_in_of "Selects" pid g) == []
  ]

def rule_idle_deployment = \g -> [ ["IdleDeployment", did, "this Deployment owns no ReplicaSet, so it manages no Pods"]
  | d <- (graph_payloads_of "Deployment" g)
  , did <- [ (k8s_id_of d) ]
  , (graph_out_of "Owns" did g) == []
  ]

-- A Service without spec.selector (e.g. ExternalName) selects nothing by design.
def rule_unused_service = \g -> [ ["UnusedService", sid, "the selector of this Service matches no Pod"]
  | s <- (graph_payloads_of "Service" g)
  , hamt_has_path "spec.selector" s
  , sid <- [ (k8s_id_of s) ]
  , (graph_out_of "Selects" sid g) == []
  ]

def rule_dangling_ingress = \g -> [ ["DanglingIngress", (k8s_id_of i), "this Ingress routes to a Service that does not exist"]
  | i <- (graph_payloads_of "Ingress" g)
  , hamt_has_path "spec.rules" i
  , rule <- (hamt_path "spec.rules" i)
  , hamt_has_path "http.paths" rule
  , path <- (hamt_path "http.paths" rule)
  , hamt_has_path "backend.service.name" path
  , (graph_has_node (k8s_ref "Service" (k8s_scope i) (hamt_path "backend.service.name" path) g) g) == false
  ]

def rule_missing_configmap = \g -> [ ["MissingConfigMap", wid, "this workload references a ConfigMap that does not exist"]
  | [wid, ws] <- (k8s_workloads g)
  , cid <- (k8s_config_ids wid ws g)
  , (graph_has_node cid g) == false
  ]

def rule_dependency_cycle = \g -> [ ["DependencyCycle", c, "these resources own or depend on each other in a cycle"]
  | c <- (graph_scc g)
  , (length c) > 1
  ]

def compliance = k8s_graph |> fold (\_ g -> (rule_unselected_pod g) ++ (rule_idle_deployment g) ++ (rule_unused_service g) ++ (rule_dangling_ingress g) ++ (rule_missing_configmap g) ++ (rule_dependency_cycle g)) 0
