-- tasks.gatwd — named, reusable tasks over a manifest directory or file.
--
-- Every task takes the manifest path as its argument (everything after `--`):
--   gatwd-k8s examples/k8s_howto/tasks.gatwd -- examples/k8s_howto/cluster                       (runs `main`)
--   gatwd-k8s examples/k8s_howto/tasks.gatwd --task trace_to_pod -- examples/k8s_howto/cluster   (one task)
-- Check: gatwd-k8s --check examples/k8s_howto/tasks.gatwd
--
-- A task is a `def`. A pipeline-bodied def is a FRAGMENT: the arguments arrive as its input
-- stream, one String node each, so `manifests` below receives the path. A lambda-bodied def is a
-- value function (curried); as a task it is called with the ARGS list. `main` is the default task.

def graph = manifests |> k8s_graph

-- stream fragments (tasks)
def who_configures_what = graph |> graph_edges_of Configures |> collect_list
def trace_to_pod        = graph
  |> graph_shortest_path Service/default/nginx-svc Pod/default/app-pod
  |> collect_list
def pod_count           = graph |> fold (\_ g -> count_kind "Pod" g) 0

-- a value function over a graph (used by pod_count; takes arguments, so it is not a task)
def count_kind = \kind g -> length (graph_payloads_of kind g)

-- No invocations at the top level: running the script defines the tasks and then runs `main`.
def main = (who_configures_what <+> trace_to_pod <+> pod_count)
