-- data.gatwd — structured data inside resources: YAML and JSON in a ConfigMap, base64 in a Secret.
--
--   gatwd-k8s examples/k8s_howto/data.gatwd -- examples/k8s_howto/data
--
-- Every decoder answers a Maybe (malformed text is Nothing, never an error), so each use says
-- what happens on Nothing — here a default, or a violation. Keys have no dots: hamt_path
-- splits on them.

-- The ConfigMap value `key` parsed by `parse` (yaml_parse or json_parse), then the field `field` of it.
def field_of = \parse key field cm -> maybe_fold nothing (\d -> hamt_get field d) (parse (hamt_path ("data." ++ key) cm))

-- A CPU quantity in millicores ("500m") as the exact fraction of a core, a Ratio: 1r2. Sums stay
-- exact (500m + 250m is 3r4), where a Float would carry rounding.
def cores : String -> Num = \q -> maybe_fold 0 (\m -> ratio m 1000) (str_to_int (str_slice 0 ((length q) - 1) q))

-- The decoded password of a Secret, as Bytes (Nothing when the data is not base64).
def password_bytes = \s -> base64_decode (hamt_path "data.password" s)

-- A Secret whose password is shorter than 8 bytes, or not base64 at all. The rule reports the
-- id, never the value; `fingerprint` is what you may show next to it.
def rule_weak_password = \g -> [ ["WeakPassword", (k8s_id_of s)]
  | s <- (graph_payloads_of "Secret" g)
  , maybe_fold true (\b -> (bytes_length b) < 8) (password_bytes s) ]
def fingerprint = \s -> maybe_fold "undecodable" (\b -> str_slice 0 12 (sha256 b)) (password_bytes s)

def cm = \g -> head (graph_payloads_of "ConfigMap" g)
def setting = \parse key field g -> field_of parse key field (cm g)

-- [replicas from the YAML entry, memory from the JSON entry, two quantities added, the weak
--  Secrets, the fingerprints of every Secret's password]
def main = manifests
  |> k8s_graph
  |> fold (\_ g -> [ (setting yaml_parse "settings" "replicas" g), (setting json_parse "limits" "memory" g), ((cores "500m") + (cores "250m")), (rule_weak_password g), [ (fingerprint s)
      | s <- (graph_payloads_of "Secret" g) ] ]) 0
