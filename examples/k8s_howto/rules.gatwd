-- rules.gatwd — an Appliance override (`-rules` / a mounted ConfigMap).
--
-- IMPORTANT: an override REPLACES the embedded rules; it is not layered on top. So this file
-- is a complete copy of the embedded compliance.gatwd (below) plus the platform team's
-- additions at the bottom:
--   1. the infra relations (inlined — a ConfigMap key is one file; alternatively mount several
--      keys and `import "/etc/gatwd/infra_relations.gatwd"`),
--   2. one extra rule, and
--   3. a `compliance` that runs over infra_graph instead of k8s_graph.
-- Edit it and a running `-interval` operator picks the change up on its next check.

-- Use-case rules of the Kubernetes compliance operator. They run over the typed
-- graph the embedded k8s prelude derives (k8s_graph) and are the part an operator
-- hot-reloads from a ConfigMap. Each rule is a closure from the graph to a list of
-- [violation, resource] pairs; an empty list means the cluster is compliant.
--
--   UnselectedPod:    a Pod that no Service selects, so it receives no traffic.
--   IdleDeployment:   a Deployment that owns no ReplicaSet, so it manages no Pods.
--   UnusedService:    a Service with a selector that selects no Pod.
--   DanglingIngress:  an Ingress routing to a Service that does not exist.
--   MissingConfigMap: a Pod/Deployment referencing a ConfigMap that does not exist.
--   DependencyCycle:  resources that (transitively) own/depend on each other; the
--                     resource is the list of ids in the strongly connected component.
--
-- Usage over one resource stream:
--   spawn StrVal: ./manifests |> manifests |> compliance        (offline)
--   spawn StrVal: default |> k8s_resources |> compliance        (live cluster)

def rule_unselected_pod = \g -> [ ["UnselectedPod", pid] | p <- (graph_payloads_of "Pod" g), pid <- [ (k8s_id_of p) ], (graph_in_of "Selects" pid g) == [] ]

def rule_idle_deployment = \g -> [ ["IdleDeployment", did] | d <- (graph_payloads_of "Deployment" g), did <- [ (k8s_id_of d) ], (graph_out_of "Owns" did g) == [] ]

-- A Service without spec.selector (e.g. ExternalName) selects nothing by design.
def rule_unused_service = \g -> [ ["UnusedService", sid] | s <- (graph_payloads_of "Service" g), hamt_has_path "spec.selector" s, sid <- [ (k8s_id_of s) ], (graph_out_of "Selects" sid g) == [] ]

def rule_dangling_ingress = \g -> [ ["DanglingIngress", (k8s_id_of i)] | i <- (graph_payloads_of "Ingress" g), hamt_has_path "spec.rules" i, rule <- (hamt_path "spec.rules" i), hamt_has_path "http.paths" rule, path <- (hamt_path "http.paths" rule), hamt_has_path "backend.service.name" path, (graph_has_node (k8s_ref "Service" (k8s_scope i) (hamt_path "backend.service.name" path) g) g) == false ]

def rule_missing_configmap = \g -> [ ["MissingConfigMap", wid] | [wid, ws] <- (k8s_workloads g), cid <- (k8s_config_ids wid ws g), (graph_has_node cid g) == false ]

def rule_dependency_cycle = \g -> [ ["DependencyCycle", c] | c <- (graph_scc g), (length c) > 1 ]


-- ---- additions ------------------------------------------------------------------------
type InfraNodeColor = DBMS | Database
type InfraEdgeColor = UsesDatabase | HostedOn

def secret_target = \s -> hamt_get "gatwd.io/database" (hamt_path "metadata.annotations" s)

def rel_uses_database = fold (\_ g -> graph_add_edges [ ["UsesDatabase", 1, (k8s_id_of s), did] | s <- (graph_payloads_of "Secret" g), hamt_has_path "metadata.annotations" s, hamt_has "gatwd.io/database" (hamt_path "metadata.annotations" s), did <- [ (k8s_ref "Database" (k8s_scope s) (secret_target s) g) ], graph_has_node did g ] g) graph_empty

def rel_hosted_on = fold (\_ g -> graph_add_edges [ ["HostedOn", 1, (k8s_id_of d), mid] | d <- (graph_payloads_of "Database" g), hamt_has_path "spec.dbms" d, mid <- [ (k8s_ref "DBMS" (k8s_scope d) (hamt_path "spec.dbms" d) g) ], graph_has_node mid g ] g) graph_empty

-- The extended pipeline: the original k8s_graph, then the new passes.
def infra_graph = k8s_graph |> rel_uses_database |> rel_hosted_on

-- A Database that no Secret holds credentials for.
def rule_database_without_credentials = \g -> [ ["DatabaseWithoutCredentials", did] | d <- (graph_payloads_of "Database" g), did <- [ (k8s_id_of d) ], (graph_in_of "UsesDatabase" did g) == [] ]

def compliance = infra_graph |> fold (\_ g -> (rule_unselected_pod g) ++ (rule_idle_deployment g) ++ (rule_unused_service g) ++ (rule_dangling_ingress g) ++ (rule_missing_configmap g) ++ (rule_dependency_cycle g) ++ (rule_database_without_credentials g)) 0
