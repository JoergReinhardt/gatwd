-- rules.gatwd — an Appliance override (`--rules` / a mounted ConfigMap).
--
-- An override is LAYERED on top of the embedded rules (`--rules-mode layer`, the default): the
-- embedded compliance.gatwd loads first, then this file, so it contains only what changes and can
-- call every embedded `rule_*` closure. Redefining a name (here: `compliance`) overrides the
-- embedded one; the operator reports what was overridden and what was added at start-up and on
-- every reload. With `--rules-mode replace` this file would be the WHOLE rule set instead (it
-- would then need a copy of the embedded rules — `gatwd-k8s-operator rules cat` prints them).
--
-- This file adds:
--   1. the infra relations (inlined — a ConfigMap key is one file; alternatively mount several
--      keys and `import "infra_relations.gatwd"`, resolved against THIS file's directory),
--   2. one extra rule, and
--   3. a `compliance` that runs the six embedded rules and the new one over infra_graph.
-- Edit it and a running `--interval` operator picks the change up on its next check; if the edit
-- is broken, the operator reports why and keeps checking with the last good rules.

-- ---- additions ------------------------------------------------------------------------
type InfraNodeColor = DBMS | Database
type InfraEdgeColor = UsesDatabase | HostedOn

def secret_target = \s -> hamt_get "gatwd.io/database" (hamt_path "metadata.annotations" s)

def rel_uses_database = fold (\_ g -> graph_add_edges [ ["UsesDatabase", 1, (k8s_id_of s), did]
    | s <- (graph_payloads_of "Secret" g)
    , hamt_has_path "metadata.annotations" s
    , hamt_has "gatwd.io/database" (hamt_path "metadata.annotations" s)
    , did <- [ (k8s_ref "Database" (k8s_scope s) (secret_target s) g) ]
    , graph_has_node did g ] g) graph_empty

def rel_hosted_on = fold (\_ g -> graph_add_edges [ ["HostedOn", 1, (k8s_id_of d), mid]
    | d <- (graph_payloads_of "Database" g)
    , hamt_has_path "spec.dbms" d
    , mid <- [ (k8s_ref "DBMS" (k8s_scope d) (hamt_path "spec.dbms" d) g) ]
    , graph_has_node mid g ] g) graph_empty

-- The extended pipeline: the original k8s_graph, then the new passes.
def infra_graph = k8s_graph |> rel_uses_database |> rel_hosted_on

-- A Database that no Secret holds credentials for.
def rule_database_without_credentials = \g -> [ ["DatabaseWithoutCredentials", did]
  | d <- (graph_payloads_of "Database" g)
  , did <- [ (k8s_id_of d) ]
  , (graph_in_of "UsesDatabase" did g) == [] ]

def compliance = infra_graph |> fold (\_ g -> (rule_unselected_pod g) ++ (rule_idle_deployment g) ++ (rule_unused_service g) ++ (rule_dangling_ingress g) ++ (rule_missing_configmap g) ++ (rule_dependency_cycle g) ++ (rule_database_without_credentials g)) 0
