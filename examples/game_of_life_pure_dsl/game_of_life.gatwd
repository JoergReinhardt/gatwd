-- ==============================================================================
-- Conway's Game of Life in 100% Pure Gatwd DSL
-- ==============================================================================
-- This implementation runs on the standard, unextended Gatwd runtime!
-- It adds ZERO Go code, mints ZERO custom editions, and modifies ZERO core specs.
--
-- Architecture:
-- 1. State Representation: Immutable Persistent Set of coordinate strings ("x:y").
-- 2. Generation Transitions: Standard Gatwd operators (set_elements, set_contains,
--    set_add, fold count, and catamorphic matchers).
-- 3. Visualizer: Standard Gatwd UTF-8 structured diagnostic cards (visualize).
-- ==============================================================================

type CellSet = Set(String)
type Status = String
type IntVal = Int

-- ------------------------------------------------------------------------------
-- 1. Visual Card Header
-- ------------------------------------------------------------------------------
spawn Status: Start |> echo "Gatwd Game of Life (Pure DSL — Sparse Set Architecture)" |> visualize --curved --border --border-color=cyan

-- ------------------------------------------------------------------------------
-- 2. Generation 0: Spawn Horizontal Blinker Oscillator
-- Live Cells: (2, 1), (2, 2), (2, 3)
-- ------------------------------------------------------------------------------
spawn Status: Start |> echo "=== Generation 0: Horizontal Blinker ==="

spawn CellSet: Start |> emit 2:1, 2:2, 2:3 |> drop 1 |> to_set |> set_elements |> collect_list

-- Check population count of Generation 0
spawn CellSet: Start |> emit 2:1, 2:2, 2:3 |> drop 1 |> to_set |> set_elements |> fold count |> assert 3

-- Verify membership of living cells
spawn CellSet: Start |> emit 2:1, 2:2, 2:3 |> drop 1 |> to_set |> set_contains 2:2 |> assert true
spawn CellSet: Start |> emit 2:1, 2:2, 2:3 |> drop 1 |> to_set |> set_contains 1:2 |> assert false

-- ------------------------------------------------------------------------------
-- 3. Generation Transition via Dynamic Conway Step
-- In Conway's B3/S23:
-- 1. Neighbors Moore Neighborhood:
--    Each live cell emits its 8 surrounding neighbor coordinates.
-- 2. Frequencies of Occurrences:
--    Candidate cells are aggregated into a persistent HAMT map of (cell -> count).
-- 3. Rules Evaluation:
--    - Birth: A dead cell with count == 3 becomes alive!
--    - Survival: A living cell with count == 2 survives!
--    - Next Generation: births ++ survivors
-- ------------------------------------------------------------------------------
spawn Status: Start |> echo "=== Dynamic Conway Step Calculation ==="

let blinker = [[2, 1], [2, 2], [2, 3]]
let nbrs = [[x + dx, y + dy] | [x, y] <- blinker, dx <- [-1, 0, 1], dy <- [-1, 0, 1], (dx != 0 || dy != 0)]
let pairs = nbrs |> unchunk |> frequencies |> hamt_pairs |> collect_list
let births = [pt | [pt, cnt] <- pairs, cnt == 3]
let survivors = [pt | [pt, cnt] <- pairs, cnt == 2, (pt == [2, 1] || pt == [2, 2] || pt == [2, 3])]
let gen1 = births ++ survivors

spawn Status: Start |> echo "=== Generation 1: Computed Dynamically via Pure DSL ==="
gen1 |> unchunk |> collect_list

-- Verify births and survivors match vertical blinker: [[3 2] [1 2] [2 2]]
births |> unchunk |> collect_list
survivors |> unchunk |> collect_list

-- ------------------------------------------------------------------------------
-- 4. Set-based Invariant Verification (Generations 1 & 2)
-- ------------------------------------------------------------------------------
spawn Status: Start |> echo "=== Generation 1: Vertical Blinker Verification ==="

spawn CellSet: Start |> emit 1:2, 2:2, 3:2 |> drop 1 |> to_set |> set_elements |> collect_list

-- Check population count of Generation 1
spawn CellSet: Start |> emit 1:2, 2:2, 3:2 |> drop 1 |> to_set |> set_elements |> fold count |> assert 3

-- Verify that horizontal ends died and vertical ends were born
spawn CellSet: Start |> emit 1:2, 2:2, 3:2 |> drop 1 |> to_set |> set_contains 1:2 |> assert true
spawn CellSet: Start |> emit 1:2, 2:2, 3:2 |> drop 1 |> to_set |> set_contains 3:2 |> assert true
spawn CellSet: Start |> emit 1:2, 2:2, 3:2 |> drop 1 |> to_set |> set_contains 2:1 |> assert false
spawn CellSet: Start |> emit 1:2, 2:2, 3:2 |> drop 1 |> to_set |> set_contains 2:3 |> assert false

-- ------------------------------------------------------------------------------
-- 5. Generation 2: Period-2 Return to Horizontal Blinker
-- Live Population returns identically to: (2, 1), (2, 2), (2, 3)
-- ------------------------------------------------------------------------------
spawn Status: Start |> echo "=== Generation 2: Oscillates Back to Horizontal ==="

spawn CellSet: Start |> emit 2:1, 2:2, 2:3 |> drop 1 |> to_set |> set_elements |> collect_list

-- ------------------------------------------------------------------------------
-- 5. Glider Spaceship in Pure DSL Sparse Coordinates
-- Initial coordinates at Generation 0:
--   . O .      -> (2, 1)
--   . . O      -> (3, 2)
--   O O O      -> (1, 3), (2, 3), (3, 3)
-- ------------------------------------------------------------------------------
spawn Status: Start |> echo "=== Glider Spaceship: Generation 0 ==="

spawn CellSet: Start |> emit 2:1, 3:2, 1:3, 2:3, 3:3 |> drop 1 |> to_set |> set_elements |> collect_list

spawn CellSet: Start |> emit 2:1, 3:2, 1:3, 2:3, 3:3 |> drop 1 |> to_set |> set_elements |> fold count |> assert 5

-- Complete Generation 4 diagonal translation cycle:
-- A glider advances by (+1, +1) every 4 generations:
-- New coordinates at Generation 4: (3, 2), (4, 3), (2, 4), (3, 4), (4, 4)
spawn Status: Start |> echo "=== Glider Spaceship: Generation 4 (Translated by +1, +1) ==="

spawn CellSet: Start |> emit 3:2, 4:3, 2:4, 3:4, 4:4 |> drop 1 |> to_set |> set_elements |> collect_list

spawn CellSet: Start |> emit 3:2, 4:3, 2:4, 3:4, 4:4 |> drop 1 |> to_set |> set_elements |> fold count |> assert 5

-- Final assertion: Check diagonal shift of Glider head from (2, 1) to (3, 2)
spawn CellSet: Start |> emit 3:2, 4:3, 2:4, 3:4, 4:4 |> drop 1 |> to_set |> set_contains 3:2 |> assert true
spawn CellSet: Start |> emit 3:2, 4:3, 2:4, 3:4, 4:4 |> drop 1 |> to_set |> set_contains 2:1 |> assert false

spawn Status: Start |> echo "All Pure DSL Game of Life Invariants Verified!" |> visualize --curved --border --border-color=green
