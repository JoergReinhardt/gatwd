-- ==============================================================================
-- Conway's Game of Life — 100% pure gatwd
-- ==============================================================================
-- Runs on the STOCK `gatwd` binary. The transition rule AND the generational
-- loop are both pure DSL — no Go, no custom steps, no embedded strings. The
-- companion wrapper (main.go) only *renders*: it loads the rule from this file,
-- seeds a starting grid (e.g. a pattern file), and animates it.
--
--   ./gatwd examples/game_of_life_pure_dsl/game_of_life.gatwd   -- run the asserts
--
-- Representation: the board is a sparse list of live coordinate pairs [x, y] on
-- an unbounded integer plane.
-- ==============================================================================

type Cell = [Int]

-- One B3/S23 generation on a w x h toroidal board (edges wrap). Neighbour
-- coordinates are taken modulo the grid, so the world is bounded: patterns stay
-- within [0,w) x [0,h) and wrap around instead of drifting off to infinity.
--   births    = empty cells with exactly 3 live neighbours
--   survivors = live cells with exactly 2 live neighbours (3 already appear as
--               births, so the union gives the standard B3/S23 next state)
def wrap = \n size -> (n % size + size) % size

-- Wrap a coordinate onto the torus (also for -1 and size).
def wrap = \n size -> (n % size + size) % size

-- The 8 offsets of a Moore neighbourhood (everything but the centre).
let offsets = [[dx, dy] | dx <- [-1, 0, 1], dy <- [-1, 0, 1], (dx != 0 || dy != 0)]

-- One entry per (live cell, neighbour) pair: the wrapped neighbours of every live cell.
def neighbours = \w h live ->
    [[(wrap (x + dx) w), (wrap (y + dy) h)] | [x, y] <- live, [dx, dy] <- offsets]

-- Count occurrences: a HAMT cell -> number of live neighbours.
def tally = \cells -> fold (\acc c -> hamt_set c ((hamt_get_or 0 c acc) + 1) acc) hamt_empty cells

def births = \pairs -> [pt | [pt, n] <- pairs, n == 3]
def survivors = \live pairs -> [p | [pt, n] <- pairs, p <- live, n == 2, p == pt]

-- B3/S23: births plus survivors, from the neighbour counts.
def next_from = \live pairs -> (births pairs) ++ (survivors live pairs)
def next_gen = \w h live -> next_from live (hamt_pairs (tally (neighbours w h live)))

def conway_step = match { [live, w, h] -> (next_gen w h live) }

-- Iterate conway_step n times on a w x h torus, purely by recursion (same shape
-- as ackermann). `to_chunk` is unnecessary here because the board rides inside
-- the [state, n, w, h] tuple that conway_step destructures directly.
def evolve = match {
    [state, 0, w, h] -> state
    | [state, n, w, h] ->
        let next = [state, w, h] |> conway_step
        in [next, n - 1, w, h] |> evolve
}

-- --- Correctness invariants (on a 64x42 torus) ------------------------------
-- A blinker is a period-2 oscillator: 3 cells at every generation.
let blinker = [[2, 1], [2, 2], [2, 3]]
[blinker, 20, 64, 42] |> evolve |> to_chunk |> unchunk |> fold count |> assert 3

-- A glider is a c/4 spaceship: it translates but always has 5 cells.
let glider = [[2, 1], [3, 2], [1, 3], [2, 3], [3, 3]]
[glider, 40, 64, 42] |> evolve |> to_chunk |> unchunk |> fold count |> assert 5

-- --- The same loop as clause definitions ------------------------------------
-- A base case and a step case, curried; the transition is the match-def above.
-- (`state ++ []` keeps the board a list value; a bare variable body would stream it.)
def evolve_clause 0 w h state = state ++ []
def evolve_clause n w h state = evolve_clause (n - 1) w h (conway_step [state, w, h])

-- Clause recursion re-evaluates its argument per level, so the twin runs few generations.
evolve_clause 6 64 42 blinker |> head |> length |> assert 3
evolve_clause 6 64 42 glider |> head |> length |> assert 5
-- Parity with the match form: the same cells (as sets) after the same generations.
let by_clause = evolve_clause 6 64 42 glider |> head
let by_match = [glider, 6, 64, 42] |> evolve |> collect_list |> head
def cells_of = \b -> fold (\acc c -> set_add c acc) set_empty b
[(cells_of by_clause), (cells_of by_match)] |> map (\c -> set_elements c |> length) |> assert [5 5]
(cells_of by_clause) == (cells_of by_match) |> assert true
