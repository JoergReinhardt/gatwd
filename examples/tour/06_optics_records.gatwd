-- ==========================================================
-- gatwd Tour: 6. Optics (Lenses) on Records
-- ==========================================================
type Directory = Folder

-- Define reusable Lens functions!
def list_files = ls -l %s |> parse_record Perms Links Owner Group Size Month Day Time Name
def get_name = focus Name
def secure_file = update Owner "root_admin" |> focus Owner

-- 1. Focus: Extracts just the File Name
spawn Directory: /etc |> list_files |> get_name |> drop 1 |> take 3

-- 2. Update: Functionally mutates the Owner field immutably!
spawn Directory: /etc |> list_files |> secure_file |> drop 1 |> take 3
