-- ==========================================================
-- gatwd Tour: 10. Applicatives (Split ***)
-- ==========================================================
type Node = Server

def branch_logic = (echo Fst_%s &&& echo Snd_%s)
def apply_concurrent = [echo LeftAppliesTo_%s *** echo RightAppliesTo_%s]
def combine = format_tuple "(%s, %s)"

-- 1. FanOut (&&&) yields a Tuple (Fst, Snd)
-- 2. Applicative Split [***] concurrently applies adapters to Tuples
spawn Node: A |> branch_logic |> apply_concurrent |> combine
