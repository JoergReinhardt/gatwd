type Nodes = List(Server)
type PodHierarchy = Tree(Pod)

def stream_children = echo Child_1 |> echo Child_2
def navigate_to_first = build_tree "Root_Pod" |> into_zipper |> down |> extract

-- 1. Lists
spawn Nodes: Cluster |> echo Node1 |> echo Node2 |> echo Node3 |> collect_list

-- 2. Trees and Zippers
spawn PodHierarchy: Kube |> stream_children |> navigate_to_first
