-- ==============================================================================
-- gatwd Tour: 23. Computability & Beyond: The Ackermann Function
-- ==============================================================================
-- The Ackermann function A(m, n) is the classic canonical example in computability
-- theory of a total computable function that is *not* primitive recursive. It
-- grows faster than any primitive recursive function (forming the basis of
-- hyperoperations beyond addition, multiplication, and exponentiation).
--
-- Mathematical Definition:
--   A(0, n) = n + 1
--   A(m, 0) = A(m - 1, 1)                  for m > 0
--   A(m, n) = A(m - 1, A(m, n - 1))        for m > 0, n > 0
--
-- In gatwd, Ackermann demonstrates:
--   1. Fixed-size tuple and list pattern matching: [0, n], [m, 0], [m, n]
--   2. Infix arithmetic expressions in match arms: (n + 1), (m - 1)
--   3. Pipeline-level let-bindings for nested recursion: let res = ... in ...
--   4. Deep recursion over immutable state with automatic stack safety
-- ==============================================================================

type NatPair = List(Int)

-- 1. Definition of the Ackermann Function
def ackermann = match {
    [0, n] -> n + 1
    | [m, 0] -> [m - 1, 1] |> ackermann
    | [m, n] -> let res = [m, n - 1] |> ackermann in [m - 1, res] |> ackermann
}

-- 2. Base Hyperoperation 0: Successor
-- A(0, 0) = 1, A(0, 4) = 5
spawn NatPair: [0, 0] |> ackermann |> assert 1
spawn NatPair: [0, 4] |> ackermann |> assert 5

-- 3. Hyperoperation 1: Addition-like
-- A(1, n) = n + 2
-- A(1, 0) = 2, A(1, 2) = 4, A(1, 3) = 5
[1, 0] |> ackermann |> assert 2
[1, 2] |> ackermann |> assert 4
[1, 3] |> ackermann |> assert 5

-- 4. Hyperoperation 2: Multiplication-like
-- A(2, n) = 2n + 3
-- A(2, 0) = 3, A(2, 1) = 5, A(2, 2) = 7, A(2, 3) = 9
[2, 0] |> ackermann |> assert 3
[2, 1] |> ackermann |> assert 5
[2, 2] |> ackermann |> assert 7
[2, 3] |> ackermann |> assert 9

-- 5. Hyperoperation 3: Exponential / Tower
-- A(3, n) = 2^(n + 3) - 3
-- A(3, 0) = 2^3 - 3 = 5
-- A(3, 1) = 2^4 - 3 = 13
-- A(3, 2) = 2^5 - 3 = 29
[3, 0] |> ackermann |> assert 5
[3, 1] |> ackermann |> assert 13
[3, 2] |> ackermann |> assert 29
