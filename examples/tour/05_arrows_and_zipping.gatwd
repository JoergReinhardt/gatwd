-- ==========================================================
-- gatwd Tour: 5. Kleisli Arrows & Zipping
-- Run: ./gatwd examples/tour/05_arrows_and_zipping.gatwd
-- ==========================================================
type User = Profile

-- 1. Kleisli Fan-Out (&&&)
-- Routes the single User Node into TWO independent adapters concurrently,
-- and zips their results into pairs!
spawn User: joerg |> (date &&& whoami)

-- 2. Stream Zipping
-- Pairs every value of the primary stream with what a secondary adapter makes of it:
-- the result is the pair [Primary: joerg, <the date>], not the date alone.
spawn User: joerg |> echo Primary: %s |> zip date
