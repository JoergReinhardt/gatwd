-- ==========================================================
-- gatwd Tour: 8. Folding, Filtering (MaybeT), and Memoization
-- ==========================================================
type Node = Dummy

-- Define Reusable Catamorphisms
def count_gatwd_files = ls . . |> filter "gatwd" |> fold count
def heavy_computation = memoize echo Computed_%s

-- 1. Filtering (MaybeT) and Folding
spawn Node: A |> count_gatwd_files

-- 2. Memoization (Functional Caching)
spawn Node: A |> echo Node_%s |> echo Node_%s |> heavy_computation
