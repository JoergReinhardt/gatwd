-- ==========================================================
-- gatwd Tour: 22. Structural Arrow Routing
-- Run: ./gatwd examples/tour/22_structural_arrows.gatwd
-- ==========================================================
type IntVal = Int

-- 1. Native Kleisli FanOut (&&&)
-- Routes into two concurrent mathematical branches via infix operator sections,
-- yielding a Tuple of the results!
spawn IntVal: 1 |> (+ 100 &&& + 200) |> visualize --color-type=Tuple:magenta

-- 2. Native Pattern Matching (Catamorphisms)
-- Match routers compile full sub-pipelines per branch!
spawn IntVal: 99 |> match { 99 -> + 1 |> + 2 } |> visualize --color-val=102:green

