-- ==========================================================
-- gatwd Tour: 7. Sets & Tuples (Cyclic Graphs & Zipping)
-- ==========================================================
type Node = Server

def get_all_duplicates = ls . .
def get_unique_files = get_all_duplicates |> distinct
def merge = format_tuple "(%s, %s)!"

-- 1. Sets and Deduplication
spawn Node: dummy |> get_unique_files |> take 3

-- 2. Tuples and FanOut Formatting
-- (Note: &&& operators execute pure OS adapters directly)
spawn Node: A |> (echo Left_%s &&& echo Right_%s) |> merge
