-- ==========================================================
-- gatwd Tour: 2. Transducers (Streams)
-- Run: ./gatwd examples/tour/02_transducers.gatwd
-- ==========================================================
type Network = Interface

-- Transducers map/filter sequences without allocating arrays.
-- Because OS commands like 'ip a' might return thousands of lines, 
-- you can safely bound the infinite trampoline using 'take' or 'drop'.
spawn Network: eth0 |> ip a |> drop 1 |> take 2
